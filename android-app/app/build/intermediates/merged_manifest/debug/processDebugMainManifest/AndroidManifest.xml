<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.xgl34222220.hetu.preview"
    android:versionCode="462"
    android:versionName="0.4.0-test.62-preview" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <permission
        android:name="io.github.xgl34222220.hetu.preview.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="io.github.xgl34222220.hetu.preview.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_hetu"
        android:label="河图"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false" >
        <service
            android:name="io.github.xgl34222220.hetu.UpdateJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name="io.github.xgl34222220.hetu.CompactMainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="io.github.xgl34222220.hetu.ThemeSettingsActivity"
            android:exported="false"
            android:label="主题与界面" />
        <activity
            android:name="io.github.xgl34222220.hetu.HetuMainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="io.github.xgl34222220.hetu.ReferenceProxyActivity"
            android:exported="true"
            android:label="河图" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.xgl34222220.hetu.ReferenceFileManagerActivity"
            android:exported="false"
            android:label="文件管理" />
        <activity
            android:name="io.github.xgl34222220.hetu.LuoShuProxyV3Activity"
            android:exported="false"
            android:label="代理（旧 V3）" />
        <activity
            android:name="io.github.xgl34222220.hetu.LuoShuProxyV2Activity"
            android:exported="false"
            android:label="代理（旧 V2）" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProMaxProxyActivity"
            android:exported="false"
            android:label="代理（旧 Pro Max）" />
        <activity
            android:name="io.github.xgl34222220.hetu.LuoShuProxyActivity"
            android:exported="false"
            android:label="代理（旧洛书面板）" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyDashboardActivity"
            android:exported="false"
            android:label="代理（旧面板）" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyWorkspaceActivity"
            android:exported="false"
            android:label="代理（旧工作台）" />
        <activity
            android:name="io.github.xgl34222220.hetu.ComposeProxyActivity"
            android:exported="false"
            android:label="代理（旧 Compose）" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyCoreActivity"
            android:exported="false"
            android:label="内核管理" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxySubscriptionActivity"
            android:exported="false"
            android:label="订阅与配置"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyActivity"
            android:exported="false"
            android:label="代理（旧界面）" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyRuntimeCoreSettingsActivity"
            android:exported="false"
            android:label="运行核心" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxySharedNetworkSettingsActivity"
            android:exported="false"
            android:label="共享网络" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyCnIpSettingsActivity"
            android:exported="false"
            android:label="CNIP 设置" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyBypassRulesActivity"
            android:exported="false"
            android:label="绕过规则" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyAdvancedSettingsActivity"
            android:exported="false"
            android:label="高级代理配置" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyNetworkAutomationActivity"
            android:exported="false"
            android:label="网络匹配" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyAppSelectionActivity"
            android:exported="false"
            android:label="代理应用名单" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyAdblockChainActivity"
            android:exported="false"
            android:label="代理广告过滤" />
        <activity
            android:name="io.github.xgl34222220.hetu.RootTproxyActivity"
            android:exported="false"
            android:label="基础代理配置（旧）" />
        <activity
            android:name="io.github.xgl34222220.hetu.ProxyNetworkMatchActivity"
            android:exported="false"
            android:label="网络匹配" />

        <service
            android:name="io.github.xgl34222220.hetu.ProxyNetworkMatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Root proxy default-network continuity and optional environment matching" />
        </service>
        <service
            android:name="io.github.xgl34222220.hetu.DnsVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE" >
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User activated local DNS filtering VPN with application exclusions" />
        </service>

        <receiver
            android:name="io.github.xgl34222220.hetu.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name="io.github.xgl34222220.hetu.MihomoVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE" >
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User initiated local Mihomo proxy and domain filtering VPN" />
        </service>

        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="io.github.xgl34222220.hetu.preview.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>