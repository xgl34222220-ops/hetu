    <background android:drawable="@drawable/ic_hetu_official_background" />
    <foreground android:drawable="@mipmap/ic_hetu_official_foreground" />
    <monochrome android:drawable="@mipmap/ic_hetu_official_monochrome" />
</adaptive-icon>
