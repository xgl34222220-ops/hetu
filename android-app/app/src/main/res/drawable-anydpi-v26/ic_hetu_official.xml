<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. Same resource name as the packaged legacy ic_hetu_official.webp,
     which stays byte-identical; on API 26+ (= minSdk) this anydpi variant is the one resolved. -->
