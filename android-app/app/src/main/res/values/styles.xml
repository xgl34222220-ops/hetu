<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#317C70</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F5F2</item>
        <item name="android:navigationBarColor">#F4F5F2</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F4F5F2</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#8DD3C3</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#121714</item>
        <item name="android:navigationBarColor">#121714</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#121714</item>
    </style>
</resources>
