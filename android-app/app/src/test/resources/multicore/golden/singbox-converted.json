  "route": {
    "rules": [
      {
        "inbound": ["hetu-tproxy", "hetu-redirect", "hetu-dns-in"],
        "action": "sniff"
      },
      {
        "inbound": ["hetu-dns-in"],
        "action": "hijack-dns"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": ["hetu-adblock"]
          },
          {
            "rule_set": ["hetu-adblock-allow"],
            "invert": true
          }
        ],
        "action": "reject"
      },
      {
        "rule_set": ["rp-ads"],
        "action": "reject"
      },
      {
        "domain": ["api.example.com"],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "domain_suffix": ["google.com"],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "domain_keyword": ["youtube"],
        "action": "route",
        "outbound": "Streaming"
      },
      {
        "domain_regex": ["^.*\\.netflix\\.com$"],
        "action": "route",
        "outbound": "Streaming"
      },
      {
        "rule_set": ["geosite-cn"],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "rule_set": ["rp-lan-ips"],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": ["10.0.0.0/8"],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": ["fd00::/8"],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "port": [123],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "network": ["udp"]
          },
          {
            "port": [443]
          }
        ],
        "action": "reject"
      },
      {
        "package_name": ["com.tencent.mm"],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "rule_set": ["geoip-cn"],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "source_ip_cidr": ["192.168.50.0/24"],
        "action": "route",
        "outbound": "DIRECT"
      }
    ],
    "rule_set": [
      {
        "type": "inline",
        "tag": "hetu-adblock",
        "rules": [
          {
            "domain_suffix": ["ads.example.net", "tracker.example.org"]
          }
        ]
      },
      {
        "type": "inline",
        "tag": "hetu-adblock-allow",
        "rules": [
          {
            "domain_suffix": ["ok.tracker.example.org"]
          }
        ]
      },
      {
        "type": "inline",
        "tag": "rp-ads",
        "rules": [
          {
            "domain": ["ads.example.org"],
            "domain_suffix": ["doubleclick.net"]
          }
        ]
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
        "download_detour": "Proxy",
        "update_interval": "72h"
      },
      {
        "type": "inline",
        "tag": "rp-lan-ips",
        "rules": [
          {
            "ip_cidr": ["192.168.0.0/16"]
          }
        ]
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "download_detour": "Proxy",
        "update_interval": "72h"
      }
    ],
    "final": "Proxy",
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:29090",
      "secret": "fixture-secret",
