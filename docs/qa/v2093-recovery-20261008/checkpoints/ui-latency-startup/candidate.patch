+        val app = ApplicationProvider.getApplicationContext<Application>()
+        app.getSharedPreferences("hetu", 0).edit().clear()
+            .putBoolean("proxyCustomApiEnabled", true).putString("proxyCustomApiHost", "127.0.0.1")
