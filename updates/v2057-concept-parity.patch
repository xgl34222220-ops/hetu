+/** Panel menu variants preserve the concept's compact rows, caption and dimmed backdrop. */
+@Composable
+internal fun PanelChoiceMenu(
+    title: String?,
+    choices: List<HxChoice>,
+    selected: String?,
+    onPick: (String) -> Unit,
+    onDismiss: () -> Unit,
+    footer: String? = null,
+) {
+    val c = Hx.colors
+    val anchor = remember { HxAnchor.take() }
+    if (anchor == null) {
+        HxChoiceSheet(title.orEmpty(), choices, selected, onPick, onDismiss, footer = footer, dimBehind = true)
+        return
+    }
+    HxAnchoredMenu(anchor, onDismiss, dimBehind = true) { close ->
+        if (!title.isNullOrBlank()) {
+            Text(title, style = MaterialTheme.typography.labelSmall, color = c.textMuted,
+                modifier = Modifier.padding(horizontal = 13.dp, vertical = 7.dp))
+            HorizontalDivider(color = c.line.copy(alpha = .45f), thickness = .5.dp)
+        }
+        choices.forEachIndexed { index, choice ->
+            Row(Modifier.fillMaxWidth().clickable(enabled = choice.enabled) { close { onPick(choice.id) } }
+                .padding(horizontal = 13.dp, vertical = 9.dp), verticalAlignment = Alignment.CenterVertically) {
+                Text(choice.label, fontSize = 13.sp, lineHeight = 17.sp,
+                    fontWeight = if (choice.id == selected) FontWeight.SemiBold else FontWeight.Medium,
+                    color = if (choice.id == selected) c.accent else c.text, modifier = Modifier.weight(1f))
+                if (choice.id == selected) Icon(Icons.Rounded.Check, null, tint = c.accent, modifier = Modifier.size(17.dp))
+            }
+            if (index != choices.lastIndex) HorizontalDivider(Modifier.padding(horizontal = 12.dp),
+                color = c.line.copy(alpha = .4f), thickness = .5.dp)
+        }
+        if (!footer.isNullOrBlank()) Text(footer, style = MaterialTheme.typography.labelSmall, color = c.textFaint,
+            modifier = Modifier.padding(horizontal = 13.dp, vertical = 8.dp))
+    }
+}
