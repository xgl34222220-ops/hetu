+dispatch=script[script.rindex('case "${1:-status}" in'):]
+# Parse the actual Java varargs call, counting only commas outside strings/parens.
+call=java.split('runJsonWithTimeout(125000L,"start",',1)[1].split(');',1)[0]
+args=[]; start=depth=0; quoted=escape=False
+for i,c in enumerate(call):
+    if quoted:
+        if escape: escape=False
+        elif c=='\\': escape=True
+        elif c=='"': quoted=False
+    elif c=='"': quoted=True
+    elif c=='(': depth+=1
+    elif c==')': depth-=1
+    elif c==',' and depth==0: args.append(call[start:i].strip());start=i+1
+args.append(call[start:].strip())
+assert len(args)==30, (len(args),args)
