+package io.github.xgl34222220.hetu
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+/**
+ * Guard the production controls that correspond to Settings concept pages 03-33.
+ * These are structure/interaction gates; rendered state snapshots live in
+ * [NativeConceptScreenshotTest].
+ */
+class SettingsStateCoverage61Test {
+    private fun source(path: String) = File("src/main/java/io/github/xgl34222220/hetu/$path").readText()
+
+    @Test fun settingsMenusMatchReferenceOptions() {
+        val s = source("app/SettingsScreen.kt")
+        listOf("overview", "proxies", "providers", "conn", "rules", "sets", "logs").forEach { assertTrue(s.contains("HxChoice(\"$it\"")) }
+        listOf("跟随系统", "简体中文", "繁體中文", "English", "Русский").forEach { assertTrue(s.contains(it)) }
+        listOf("渐进式模糊", "高斯模糊", "80%", "90%", "100%", "110%", "120%").forEach {
+            val ok = s.contains(it) || when (it) {
+                "80%" -> s.contains(".8f")
+                "90%" -> s.contains(".9f")
+                "100%" -> s.contains("1f")
+                "110%" -> s.contains("1.1f")
+                "120%" -> s.contains("1.2f")
+                else -> false
+            }
+            assertTrue("missing theme choice $it", ok)
+        }
+    }
+
+    @Test fun notificationMenusCoverAllThreeButtons() {
+        val s = source("app/ToolScreens.kt")
+        assertTrue(s.contains("listOf(2, 3, 5, 10, 30, 60)"))
+        listOf("首页", "面板", "策略", "面板浮窗", "策略浮窗", "工具", "设置").forEach { assertTrue(s.contains(it)) }
+        listOf("重载", "重启", "停止", "隐藏通知", "无").forEach { assertTrue(s.contains(it)) }
+        assertTrue(s.contains("(0 until 3).forEach"))
+    }
+
+    @Test fun restoreMirrorAndLicensesMatchConceptBoundary() {
+        val settings = source("app/SettingsScreen.kt")
+        val components = source("app/SettingsReferenceComponents.kt")
+        val about = source("app/MiscScreens.kt")
+        assertTrue(settings.contains("恢复备份？"))
+        assertTrue(settings.contains("正在运行的代理不会自动重启"))
+        assertTrue(components.contains("请填写 http/https 地址"))
+        assertTrue(components.contains("SettingsDialog(\"加速下载\""))
+        assertTrue(about.contains("SettingsRow(\"内置核心\", subtitle = \"Mihomo\""))
+        assertTrue(about.contains("openAsset(\"Mihomo\", \"MIHOMO-LICENSE\")"))
+        assertTrue(about.contains("openAsset(\"AdGuard\", \"ADGUARD-LICENSE\")"))
+        assertTrue(about.contains("openAsset(\"Lucide\", \"licenses/lucide.txt\")"))
+        assertFalse(listOf(settings, components, about).any { it.contains("示例数据") })
+    }
+}
