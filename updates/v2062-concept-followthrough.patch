+/** The existing provider's optional fields stay unknown unless actually supplied.
+ * Schema: https://ipwhois.io/documentation (same endpoint, egress and request limits).
+ */
+internal fun parseWanRuntimeInfo(body: String): WanRuntimeInfo {
+    val json = JSONObject(body)
+    require(json.optBoolean("success", false)) { "WAN lookup failed" }
+    fun text(obj: JSONObject?, key: String): String = obj?.optString(key, "")?.trim()
+        ?.takeUnless { it.isEmpty() || it == "null" || it == "—" } ?: "—"
+    val address = text(json, "ip")
+    require(address != "—") { "WAN response has no address" }
+    val connection = json.optJSONObject("connection")
+    val asn = text(connection, "asn").let { if (it.all(Char::isDigit)) "AS$it" else it }
+    val latitude = json.optDouble("latitude", Double.NaN)
+    val longitude = json.optDouble("longitude", Double.NaN)
+    val coordinates = if (latitude.isFinite() && longitude.isFinite() && latitude in -90.0..90.0 && longitude in -180.0..180.0)
+        String.format(java.util.Locale.US, "%.4f, %.4f", latitude, longitude) else "—"
+    return WanRuntimeInfo(address = address, countryCode = text(json, "country_code").takeUnless { it == "—" }.orEmpty(),
+        country = text(json, "country"), region = text(json, "region"), city = text(json, "city"),
+        isp = text(connection, "isp"), asn = asn, organization = text(connection, "org"),
+        ipType = text(json, "type").takeIf { it == "IPv4" || it == "IPv6" } ?: "—",
+        timezone = text(json.optJSONObject("timezone"), "id"), coordinates = coordinates)
+}
