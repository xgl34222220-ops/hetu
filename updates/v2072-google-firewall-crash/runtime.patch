+  esac
+  acquire_lock || exit 0
+  [ "$GF_PID" = "$(cat "$PIDFILE" 2>/dev/null)" ] && pidcore "$GF_PID" && kill -0 "$GF_PID" 2>/dev/null || exit 0
+  [ "$(sed -n 's/^GOOGLE_FIREWALL_CLEAN=//p' "$SESSION" 2>/dev/null)" = 1 ] || exit 0
+  printf '%s\n' "$GF_NOW" > "$RUN/google-firewall-at"
+  google_firewall_cleanup
