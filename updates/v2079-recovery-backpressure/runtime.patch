+    private class ManualWorker : AbstractExecutorService() {
+        val queue = ArrayDeque<Runnable>(); private var stopped = false
+        override fun execute(task: Runnable) { if (stopped) throw RejectedExecutionException(); queue.add(task) }
+        fun drain() { while (queue.isNotEmpty()) queue.remove().run() }
+        override fun shutdown() { stopped = true }
+        override fun shutdownNow(): MutableList<Runnable> { stopped = true; return mutableListOf() }
+        override fun isShutdown() = stopped
+        override fun isTerminated() = stopped
+        override fun awaitTermination(timeout: Long, unit: TimeUnit) = stopped
+    }
+    private class ManualTimer : ScheduledThreadPoolExecutor(1) {
+        private val tasks = ArrayDeque<Future>()
+        val pending get() = tasks.count { !it.cancelled }
+        override fun schedule(task: Runnable, delay: Long, unit: TimeUnit): ScheduledFuture<*> = Future(task).also { tasks.add(it) }
+        fun fire(includeCancelled: Boolean = false) {
+            val due = tasks.toList(); tasks.clear(); due.forEach { if (includeCancelled || !it.cancelled) it.task.run() }
+        }
+        private class Future(val task: Runnable) : ScheduledFuture<Any?> {
+            var cancelled = false
+            override fun cancel(mayInterruptIfRunning: Boolean): Boolean { cancelled = true; return true }
+            override fun isCancelled() = cancelled
+            override fun isDone() = cancelled
+            override fun get(): Any? = null
+            override fun get(timeout: Long, unit: TimeUnit): Any? = null
+            override fun getDelay(unit: TimeUnit) = 0L
+            override fun compareTo(other: Delayed) = 0
+        }
+    }
