+@Implements(value = RootBridge::class, isInAndroidSdk = false)
+class RecoveryStressBridgeShadow {
+    companion object {
+        val commands = CopyOnWriteArrayList<String>()
+        var health = "degraded"
+        var duringHealth: (() -> Unit)? = null
+        var duringCore: (() -> Unit)? = null
+        var duringRepair: (() -> Unit)? = null
+        var core = "1"
+        @JvmStatic @Implementation fun hasRoot(context: Context) = true
+        @JvmStatic @Implementation fun rootShell(context: Context, command: String, timeout: Long): RootBridge.Result {
+            commands += command
+            require(!command.contains("service.d") && !command.contains("'start'") && !command.contains("'stop'"))
+            if (command.contains("repair-network")) {
+                val callback = duringRepair; duringRepair = null; callback?.invoke()
+                return RootBridge.Result(91, "private-fixture-error")
+            }
+            if (command.endsWith("'network-health'")) {
+                val callback = duringHealth; duringHealth = null; callback?.invoke()
+                return RootBridge.Result(0, JSONObject().put("ok", true).put("networkIntegrity", health)
+                    .put("networkFault", if (health == "healthy") "" else "watchdog-missing")
+                    .put("dataPlaneHealthy", health == "healthy").toString())
+            }
+            require(command.contains("/proc/\$P/exe"))
+            val callback = duringCore; duringCore = null; callback?.invoke()
+            return RootBridge.Result(if (core == "?") 126 else 0, core)
+        }
+    }
+}
