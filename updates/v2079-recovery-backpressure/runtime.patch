+/** Virtual time and a withheld worker queue, using real Service methods and callbacks. */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [35], application = Application::class, shadows = [RecoveryStressBridgeShadow::class])
+class NetworkRecoveryStressTest {
