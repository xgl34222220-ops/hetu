+    private val prefs get() = app.getSharedPreferences("hetu", Context.MODE_PRIVATE)
+    private lateinit var service: ProxyNetworkMatchService
+    private lateinit var controller: ServiceController<ProxyNetworkMatchService>
+    private lateinit var callback: ConnectivityManager.NetworkCallback
+    private lateinit var epochs: NetworkEpoch<Network>
+    private val controllers = mutableListOf<ServiceController<ProxyNetworkMatchService>>()
+    private val manual = ManualWorker()
+    private val timer = ManualTimer()
+    private val a = ShadowNetwork.newInstance(401)
+    private val b = ShadowNetwork.newInstance(402)
+
+    @Before fun prepare() {
+        prefs.edit().clear().putBoolean("proxyRootWanted", true).putBoolean("proxyRootRuntimeRunning", true)
+            .putString("proxyNetworkIntegrity", "healthy").putString("proxyPolicyEgressState", "reachable")
+            .putLong("proxyPolicyEgressCheckedAt", 999L).putLong("proxyNetworkCheckedAt", 999L)
+            .putLong("proxyRootEgressVerifiedAt", 999L).putString("proxyNetworkHealthTraceId", "old-trace").commit()
+        RecoveryStressBridgeShadow.commands.clear(); RecoveryStressBridgeShadow.health = "degraded"
+        RecoveryStressBridgeShadow.core = "1"; RecoveryStressBridgeShadow.duringCore = null
+        RecoveryStressBridgeShadow.duringHealth = null; RecoveryStressBridgeShadow.duringRepair = null
+        controller = create(); service = controller.get()
+        ReflectionHelpers.setField(service, "worker", manual)
+        ReflectionHelpers.setField(service, "metrics", timer)
+        ReflectionHelpers.setField(service, "networkRecoveries", ProxyTaskCoalescer(manual) { invoke(service, "recoverQueuedNetwork") })
+        ReflectionHelpers.setField(service, "egressRequest", ProxyNetworkMatchService.EgressRequest { _, _ -> 503 })
+        callback = ReflectionHelpers.getField(service, "cb"); epochs = ReflectionHelpers.getField(service, "networkEvents")
+    }
+    private fun create(): ServiceController<ProxyNetworkMatchService> {
+        val c = Robolectric.buildService(ProxyNetworkMatchService::class.java).create(); controllers += c
+        ReflectionHelpers.getField<ExecutorService>(c.get(), "metrics").shutdownNow()
+        ReflectionHelpers.getField<ExecutorService>(c.get(), "worker").shutdownNow()
+        return c
+    }
+    @After fun finish() {
+        controllers.forEach { it.destroy() }
+        controllers.forEach { ReflectionHelpers.getField<ExecutorService>(it.get(), "journalWorker").awaitTermination(10, TimeUnit.SECONDS) }
+        timer.shutdownNow(); manual.shutdownNow()
+    }
+    private fun invoke(target: ProxyNetworkMatchService, name: String, vararg args: Any): Any? {
+        val m = ProxyNetworkMatchService::class.java.declaredMethods.single { it.name == name }; m.isAccessible = true
+        return m.invoke(target, *args)
+    }
+    private fun offMain(task: () -> Any?): Any? {
+        val thread = Executors.newSingleThreadExecutor()
+        try { return thread.submit<Any?> { task() }.get(30, TimeUnit.SECONDS) } finally { thread.shutdownNow() }
+    }
+    private fun caps() = NetworkCapabilities().also {
+        val s = Shadow.extract<ShadowNetworkCapabilities>(it)
+        s.addCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET); s.addCapability(NetworkCapabilities.NET_CAPABILITY_NOT_VPN)
+        s.addTransportType(NetworkCapabilities.TRANSPORT_WIFI)
+    }
+    private fun links(last: Int = 53) = LinkProperties().apply {
+        interfaceName = "wlan0"
+        ReflectionHelpers.callInstanceMethod<Boolean>(this, "addDnsServer",
+            ReflectionHelpers.ClassParameter.from(InetAddress::class.java, InetAddress.getByName("192.0.2.$last")))
+    }
+    private fun ready(n: Network = a, dns: Int = 53) {
+        callback.onAvailable(n); callback.onCapabilitiesChanged(n, caps()); callback.onLinkPropertiesChanged(n, links(dns))
+    }
+    private fun repairCount() = RecoveryStressBridgeShadow.commands.count { it.contains("repair-network") }
+    private fun drain() {
