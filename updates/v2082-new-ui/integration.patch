+private suspend fun testNode(repo: ProxyDashboardRepository, node: String, delays: MutableMap<String, Long>, testing: MutableMap<String, Boolean>) {
+    testing[node] = true
+    try {
+        delays[node] = repo.delay(node)
+    } catch (cancel: CancellationException) {
+        throw cancel
+    } catch (_: Exception) {
+        delays[node] = -1L
+    } finally {
+        testing.remove(node)
+    }
+}
