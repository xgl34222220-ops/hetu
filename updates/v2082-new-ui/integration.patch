+internal fun homeStatusOf(data: CompactHomeData, startupError: String?): HomeStatus = when {
+    data.operation == HomeOperation.Restart -> HomeStatus.Restarting
+    data.operation == HomeOperation.Stop -> HomeStatus.Stopping
