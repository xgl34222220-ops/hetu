+        view = view,
+        overlay = overlay,
+        actions = actions,
+        onView = { next ->
+            val previousTab = view.tab
+            view = next
+            onViewChange(next)
+            if (next.tab != previousTab) onTabChange(next.tab)
+        },
+        onOverlay = { overlay = it },
+        modifier = modifier,
+        contentPadding = contentPadding,
+        listState = listState,
+    )
