+                    ToolsListEditor(
+                        label = "接口", values = draft.interfaces, placeholder = "例如 dummy0、tun+", enabled = editable,
+                        onChange = { index, value -> onDraftChange(draft.copy(interfaces = draft.interfaces.replaced(index, value))) },
