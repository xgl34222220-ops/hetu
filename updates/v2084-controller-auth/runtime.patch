+                    assertArrayEquals(expected, wire)
+                    assertEquals(credential, prefs.getString(if (custom) "proxyCustomApiSecret" else "proxyControllerSecret", ""))
+                } finally { executor.shutdownNow() }
+            }
+        }
+    }
