+        val reveal = rememberHomeReveal(Unit, 260)
+        Box(
+            Modifier.fillMaxWidth().padding(horizontal = 28.dp).imePadding().graphicsLayer {
+                val p = reveal()
+                alpha = p
+                val scale = .93f + .07f * p
