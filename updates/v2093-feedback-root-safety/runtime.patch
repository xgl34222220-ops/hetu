+monitor_policy_value(){ sed -n "s/^$1=//p" "$MONITOR_POLICY" 2>/dev/null | head -n 1; }
+monitor_wanted(){
+  [ -r "$MONITOR_POLICY" ] || return 1
+  [ "$(monitor_policy_value NETMATCH)" = 1 ] || [ "$(monitor_policy_value TRAFFIC)" = 1 ]
