+  for WR_S in root:net_admin "0:$CORE_GROUP_ID"; do
+    [ "$("$WP_BB" setuidgid "$WR_S" "$WP_BB" id -g 2>/dev/null)" = "$CORE_GROUP_ID" ] && { WP_RUN="$WP_BB setuidgid $WR_S"; return 0; }
+  done
