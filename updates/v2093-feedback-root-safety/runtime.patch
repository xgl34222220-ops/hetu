+          rules.unshift({ domain_suffix: ["example.com"], outbound: "direct" });
+          config.route.rules = rules;
+          return config;
+        }
+    """.trimIndent() + "\n")
+
+    val ALL = listOf(BLANK, ADD_RULE, SET_DNS, MERGE_PROXIES, SING_BOX_RULE)
