+      if [ "$SH_PARENT_HELD" = 1 ] && kill -0 "$$" 2>/dev/null; then printf '%s\n' "$$" > "$LOCK_DIR/pid" 2>/dev/null || true
+      else rm -rf "$LOCK_DIR" >/dev/null 2>&1 || true; fi
+    fi
