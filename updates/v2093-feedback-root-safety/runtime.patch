+
+    // Xray JSON (v4 schema), checked with `xray run -test` 26.3.27. geoip.dat/geosite.dat ship in the core zip.
+    static final String XRAY = """
+{
+  "log": { "loglevel": "warning" },
+  "dns": {
+    "servers": [
+      { "address": "223.5.5.5", "domains": ["geosite:cn"], "expectIPs": ["geoip:cn"] },
