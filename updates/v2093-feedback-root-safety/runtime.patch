+        assertEquals(false, bypass.ok)
+        assertTrue(bypass.detail.contains("dns.alidns.com"))
+        assertNull(AdblockVerification.dnsVerdict("ad.test", real, dnsLayer = false, privateDnsHost = null).ok)
+    }
