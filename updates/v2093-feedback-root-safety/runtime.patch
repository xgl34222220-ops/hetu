+            item(key = "speed-hero") { SpeedHeroCard(speed, speedActive, ::toggleSpeed) }
+            item(key = "speed-exit") { SpeedExitCard(speed) }
+            item(key = "speed-result") { SpeedResultCard(speed) }
+            item(key = "speed-chart") { SpeedChartCard(speed) }
