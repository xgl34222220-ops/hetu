+        assertTrue(stopping.get(5, TimeUnit.SECONDS).getOrThrow().getBoolean("ok"))
+        assertFalse(prefs.getBoolean("proxyRootWanted", true))
+        assertFalse(prefs.contains("unexpectedOldObservation"))
+    }
