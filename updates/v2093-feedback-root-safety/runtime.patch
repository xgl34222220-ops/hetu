+        val rows = setOf("chatgpt", "claude", "gemini", "tiktok", "bilibili", "disney", "hulu", "netflix", "spotify", "twitch", "youtube", "apple", "github", "steam")
+        assertEquals(rows, NetworkUnlock.checkIds)
+    }
+}
