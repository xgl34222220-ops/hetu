+        assertNull("not a trace", NetworkUnlock.traceField("<html>loc=JP</html>", "loc"))
+        assertEquals("TW", mergeUnlockRegion("JP", UnlockResult("x", UnlockState.Unlocked, "TW")))
+        assertEquals("JP", mergeUnlockRegion("JP", null))
