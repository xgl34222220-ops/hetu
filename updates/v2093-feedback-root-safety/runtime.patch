+            if (!MAC_SAFE.matcher(mac).matches() || !w[2].matches("[0-9A-Fa-f:.]{2,64}")) continue;
+            String host = w.length > 3 && !w[3].equals("*") ? w[3].replaceAll("[^A-Za-z0-9._-]", "") : "";
+            out.add(new Lease(mac, w[2], host.length() > 63 ? host.substring(0, 63) : host));
+        }
+        return out;
+    }
+
+    private static List<String> nonNull(Collection<String> values) {
+        ArrayList<String> out = new ArrayList<>();
+        for (String v : values) if (v != null) out.add(v);
+        return out;
+    }
+}
diff --git a/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartPrelude.java b/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartPrelude.java
new file mode 100644
index 0000000..bb43799
--- /dev/null
+++ b/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartPrelude.java
@@ -0,0 +1,95 @@
+package io.github.xgl34222220.hetu;
+
+/**
+ * Shell fragments that let a manual start run in ONE Root invocation: cancellation receipt,
+ * optional pre-start hook, file deployment, then `exec hetu-root.sh start`.
+ *
+ * Every fragment either falls through to the next one or prints a single refusal line
+ * ({@link #ABORT}) and exits before the native transaction is dispatched, so the caller knows
+ * nothing native ran. Pure Java (no Android API) so it is host-testable.
+ */
+final class StartPrelude {
+    private StartPrelude() {}
+
+    static final String ABORT = "HETU_PRENATIVE";
+    static final String SCRIPT_DIR = "/data/adb/hetu/scripts";
+    static final String PRE_START = SCRIPT_DIR + "/pre-start.sh";
+    static final String SCRIPT_LOG = "/data/adb/hetu/run/scripts.log";
+
+    /**
+     * Reads hetu-root.sh's cancellation marker first thing in the start shell and exports it
+     * exactly like the former separate read: empty, or "digits-digits" of at most 64 chars.
+     */
+    static String cancelReceipt(String markerPath) {
+        String m = quote(markerPath);
+        return "hetu_t=''; if [ -e " + m + " ]; then hetu_t=$(cat " + m + ") || { printf '" + ABORT + "\\ttoken\\n'; exit 0; }; fi; "
+                + "case \"$hetu_t\" in '') ;; *[!0-9-]*|-*|*-|*-*-*) printf '" + ABORT + "\\ttoken\\n'; exit 0;; *-*) ;; "
+                + "*) printf '" + ABORT + "\\ttoken\\n'; exit 0;; esac; "
+                + "[ \"${#hetu_t}\" -le 64 ] || { printf '" + ABORT + "\\ttoken\\n'; exit 0; }; "
+                + "export HETU_START_CANCEL_TOKEN=\"$hetu_t\"; ";
+    }
+
+    /**
+     * The pre-start hook, same environment, log and 12 s limit as ProxyScriptHooks.run, but
+     * without any extra Root shell: when no hook exists this is one `[ -s ]` test.
+     */
+    static String preStartHook(String mode, String config) {
+        String path = quote(PRE_START);
+        return "if [ -s " + path + " ]; then ( "
+                + "mkdir -p " + quote(SCRIPT_DIR) + " /data/adb/hetu/run && chmod 700 " + quote(SCRIPT_DIR) + " || exit 45; "
+                + "export HETU_HOOK='pre-start'; "
+                + "export HETU_MODE=" + quote(mode) + "; "
+                + "export HETU_CONFIG=" + quote(config) + "; "
+                + "export HETU_BASE=/data/adb/hetu; "
+                + "export HETU_RUN_DIR=/data/adb/hetu/run; "
+                + "export HETU_SCRIPT_DIR=" + quote(SCRIPT_DIR) + "; "
+                + "{ printf '\\n[%s] hook=%s mode=%s config=%s\\n' \"$(date '+%Y-%m-%d %H:%M:%S')\" 'pre-start' "
+                + quote(mode) + " " + quote(config) + "; "
+                + "if command -v timeout >/dev/null 2>&1; then timeout 12 sh " + path + "; else sh " + path + "; fi; "
+                + "} >> " + quote(SCRIPT_LOG) + " 2>&1 ); hetu_h=$?; "
+                + "[ \"$hetu_h\" = 0 ] || { printf '" + ABORT + "\\thook\\t%s\\n' \"$hetu_h\"; exit 0; }; fi; ";
+    }
+
+    /** RootProxyManager's deployment command in its own `sh -c`, so its `set -e` really applies. */
+    static String deployment(String command) {
+        return "hetu_d=$(sh -c " + quote(command) + " 2>&1); hetu_rc=$?; "
+                + "if [ \"$hetu_rc\" != 0 ]; then printf '" + ABORT + "\\tdeploy\\t%s\\n' "
+                + "\"$(printf '%s' \"$hetu_d\" | tr '\\r\\n\\t' '   ' | head -c 300)\"; exit 0; fi; ";
+    }
+
+    /** Settings.Global private_dns_mode as hetu-root.sh's whitelist understands it. */
+    static String privateDnsMode(String raw) {
+        String value = raw == null ? "" : raw.trim();
+        switch (value) {
+            case "off": case "opportunistic": case "hostname": return value;
+            default: return "unknown";
+        }
+    }
+
+    /** The user-facing reason when the prelude refused before the native start, else null. */
+    static String refusal(String output) {
+        if (output == null) return null;
+        String text = output.trim();
+        int line = text.lastIndexOf('\n');
+        String last = (line >= 0 ? text.substring(line + 1) : text).trim();
+        if (!last.startsWith(ABORT + "\t")) return null;
+        String[] parts = last.split("\t", 3);
+        String kind = parts.length > 1 ? parts[1] : "";
+        String detail = parts.length > 2 ? parts[2].trim() : "";
+        switch (kind) {
+            case "token": return "无法确认启动撤销代次，已拒绝启动";
+            case "hook":
+                if ("124".equals(detail)) return "脚本执行超时，已停止本次操作";
+                if ("45".equals(detail)) return "无法创建脚本目录";
+                return "脚本执行失败（" + (detail.matches("[0-9]{1,3}") ? detail : "?") + "），请查看 scripts.log";
+            case "deploy": return "无法安装 Root 运行文件：" + (detail.isEmpty() ? "未知 Root 错误" : detail);
+            default: return "启动前准备未完成，已拒绝启动";
+        }
+    }
+
+    static String quote(String value) {
+        if (value == null) value = "";
+        if (value.indexOf('\0') >= 0) throw new IllegalArgumentException("Invalid shell value");
+        return "'" + value.replace("'", "'\\''") + "'";
+    }
+}
diff --git a/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartupConfigViewer.kt b/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartupConfigViewer.kt
new file mode 100644
index 0000000..bf80c61
--- /dev/null
+++ b/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartupConfigViewer.kt
@@ -0,0 +1,187 @@
+package io.github.xgl34222220.hetu
+
+import androidx.compose.foundation.ScrollState
+import androidx.compose.foundation.horizontalScroll
+import androidx.compose.ui.draw.drawWithContent
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.geometry.Size
+import androidx.compose.ui.graphics.BlendMode
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.CompositingStrategy
+import androidx.compose.ui.graphics.graphicsLayer
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.ExperimentalLayoutApi
+import androidx.compose.foundation.layout.FlowRow
+import androidx.compose.foundation.layout.Spacer
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.heightIn
+import androidx.compose.foundation.layout.height
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.itemsIndexed
+import androidx.compose.foundation.lazy.rememberLazyListState
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.text.selection.SelectionContainer
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.key
+import androidx.compose.runtime.mutableFloatStateOf
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.runtime.snapshotFlow
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.layout.onSizeChanged
+import androidx.compose.ui.text.AnnotatedString
+import androidx.compose.ui.text.TextStyle
+import androidx.compose.ui.text.TextLayoutResult
+import androidx.compose.ui.unit.dp
+import io.github.xgl34222220.hetu.home.HomeButton
+import io.github.xgl34222220.hetu.home.HomeButtonKind
+import io.github.xgl34222220.hetu.home.HomeIcons
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlin.math.roundToInt
+
+/** Read-only display; callers retain the untouched original for copy and export. */
+@Composable
+@OptIn(ExperimentalLayoutApi::class)
+internal fun StartupConfigViewer(
+    text: String,
+    style: TextStyle,
+    color: Color,
+    modifier: Modifier = Modifier,
+    annotated: ((String) -> AnnotatedString)? = null,
+    wrap: Boolean = false,
+) {
+    val chunks = remember(text) { startupConfigChunks(text) }
+    key(text) {
+        val state = rememberLazyListState()
+        val headScroll = rememberScrollState()
+        val tailScroll = rememberScrollState()
+        var tailEndX by remember { mutableFloatStateOf(0f) }
+        var tailViewportWidth by remember { mutableIntStateOf(0) }
+        var navigationJob by remember { mutableStateOf<Job?>(null) }
+        val scope = rememberCoroutineScope()
+        Column(modifier.fillMaxWidth(), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            if (chunks.size > 1) FlowRow(horizontalArrangement = Arrangement.spacedBy(8.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                HomeButton("回到开头", {
+                    navigationJob?.cancel()
+                    navigationJob = scope.launch { state.scrollToItem(0); headScroll.scrollTo(0) }
+                },
+                    kind = HomeButtonKind.Soft, icon = HomeIcons.ArrowUp, height = 44.dp)
+                HomeButton("查看末尾", {
+                    navigationJob?.cancel()
+                    navigationJob = scope.launch {
+                        // The final paragraph can exceed the viewport height. An end
+                        // anchor exposes its bottom; then reveal the end of a long line.
+                        state.scrollToItem(chunks.size)
+                        if (wrap) return@launch
+                        // Lazy placement and text measurement can finish after the vertical
+                        // scroll request. Await the real viewport and glyph measurement,
+                        // rather than deriving an offset from their initial zero values.
+                        val (endX, viewportWidth, maxScroll) = snapshotFlow {
+                            Triple(tailEndX, tailViewportWidth, tailScroll.maxValue)
+                        }.first { (endX, viewportWidth, maxScroll) ->
+                            endX > 0f && viewportWidth > 0 && maxScroll != Int.MAX_VALUE
+                        }
+                        val endOffset = (endX - viewportWidth).roundToInt().coerceIn(0, maxScroll)
+                        tailScroll.scrollTo(endOffset)
+                    }
+                },
+                    kind = HomeButtonKind.Soft, icon = HomeIcons.ArrowDown, height = 44.dp)
+            }
+            // A bounded paragraph, including very long single lines, is measured only
+            // when visible. Neither the full document nor every individual line is a Text.
+            LazyColumn(Modifier.fillMaxWidth().heightIn(max = 420.dp), state = state) {
+                itemsIndexed(chunks, key = { index, _ -> index }) { index, range ->
+                    val part = remember(text, range) { text.substring(range.start, range.end).ifEmpty { " " } }
+                    SelectionContainer {
+                        // The outer modifier measures the clipped horizontal viewport,
+                        // while TextLayoutResult measures the full paragraph inside it.
+                        val sideways = when (index) {
+                            chunks.lastIndex -> tailScroll
+                            0 -> headScroll
+                            else -> rememberScrollState()
+                        }
+                        val scroll = if (wrap) Modifier.fillMaxWidth() else Modifier.onSizeChanged {
+                            if (index == chunks.lastIndex) tailViewportWidth = it.width
+                        }.startupConfigMoreRight(sideways).horizontalScroll(sideways)
+                        val onLayout: (TextLayoutResult) -> Unit = { layout ->
+                            if (index == chunks.lastIndex) {
+                                val end = part.indexOfLast { it != '\n' && it != '\r' }.coerceAtLeast(0)
+                                tailEndX = layout.getBoundingBox(end).right
+                            }
+                        }
+                        if (annotated == null) Text(part, scroll, color = color, style = style, softWrap = wrap, onTextLayout = onLayout)
+                        else Text(remember(part, annotated) { annotated(part) }, scroll, color = color, style = style, softWrap = wrap, onTextLayout = onLayout)
+                    }
+                }
+                if (chunks.size > 1) item(key = "end") { Spacer(Modifier.height(1.dp)) }
+            }
+        }
+    }
+}
+
+/** Fades the right edge of a line while more of it lies to the right, so a cut line reads as "scroll on". */
+private fun Modifier.startupConfigMoreRight(state: ScrollState): Modifier =
+    graphicsLayer { compositingStrategy = CompositingStrategy.Offscreen }.drawWithContent {
+        drawContent()
+        if (state.value < state.maxValue) {
+            val edge = 28.dp.toPx().coerceAtMost(size.width)
+            drawRect(
+                Brush.horizontalGradient(listOf(Color.Black, Color.Transparent), startX = size.width - edge, endX = size.width),
+                topLeft = Offset(size.width - edge, 0f), size = Size(edge, size.height), blendMode = BlendMode.DstIn,
+            )
+        }
+    }
+
+private val startupSecretLine = Regex("""(?m)^(\s*(?:-\s*)?secret\s*:\s*)(['"]?)[^'"\r\n#]+\2""")
+private val startupUrlQuery = Regex("""(https?://[^\s'"?#]+)\?[^\s'"#,}\]]+""")
+
+/** Display copy with subscription-URL queries and `secret:` values hidden; copy and export keep the original. */
+internal fun maskStartupSecrets(text: String): String =
+    startupUrlQuery.replace(startupSecretLine.replace(text) { it.groupValues[1] + it.groupValues[2] + "••••••" + it.groupValues[2] }) { it.groupValues[1] + "?••••••" }
+
+private data class StartupConfigChunk(val start: Int, val end: Int)
+
+/** Keep allocations proportional to document blocks, including newline-only input. */
+private fun startupConfigChunks(text: String): List<StartupConfigChunk> {
+    if (text.isEmpty()) return emptyList()
+    val result = ArrayList<StartupConfigChunk>()
+    var start = 0
+    while (start < text.length) {
+        val limit = minOf(start + 1024, text.length)
+        var end = start
+        var lines = 0
+        var lastBreak = -1
+        while (end < limit) {
+            if (text[end++] == '\n') {
+                lastBreak = end
+                if (++lines == 24) break
+            }
+        }
+        if (end < text.length && lines < 24 && lastBreak > start) end = lastBreak
+        // Consume a delimiter touching a char-bound split so that it does not
+        // become an extra blank paragraph. Displayed content remains bounded.
+        if (end < text.length && text[end - 1] != '\n') {
+            if (text[end - 1] == '\r' && text[end] == '\n') end++
+            else if (text[end] == '\r' && end + 1 < text.length && text[end + 1] == '\n') end += 2
+            else if (text[end] == '\n') end++
+        }
+        if (end < text.length && text[end - 1].isHighSurrogate() && text[end].isLowSurrogate()) end--
+        var displayEnd = end
+        if ((end < text.length || end - start > 1024) && displayEnd > start && text[displayEnd - 1] == '\n') {
+            displayEnd--
+            if (displayEnd > start && text[displayEnd - 1] == '\r') displayEnd--
+        }
+        result += StartupConfigChunk(start, displayEnd)
+        start = end
+    }
+    return result
+}
diff --git a/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartupDiagnostics.java b/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartupDiagnostics.java
new file mode 100644
index 0000000..18b60e4
--- /dev/null
+++ b/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartupDiagnostics.java
@@ -0,0 +1,137 @@
+package io.github.xgl34222220.hetu;
+
+import java.util.*;
+import org.yaml.snakeyaml.error.YAMLException;
+
+/**
+ * Where each startup value came from: listener ports, the DNS listener and mode, and the fake-IP range,
+ * each tagged as set by the selected config file, by Hetu's runtime override, or by a default.
+ *
+ * <p>The lines are recorded at every prepare (the 启动配置 page shows them as 启动诊断, and they are
+ * kept in the app's startup-diagnostics log). Reference-cleanup notices additionally go into the private
+ * startup copy as {@code # HETU_NOTICE: } comments, which hetu-root.sh copies into core.log right after it
+ * truncates the log; without a cleanup the startup copy stays byte-identical. Pure JVM.
+ */
+final class StartupDiagnostics {
+    private StartupDiagnostics() {}
+
+    static final String NOTICE_PREFIX = "# HETU_NOTICE: ";
+    static final int MAX_LINES = 64;
+    static final String SRC_CONFIG = "配置文件", SRC_HETU = "河图运行时覆写", SRC_DEFAULT = "默认值", SRC_APP = "河图设置";
+
+    /** The full diagnostics text: cleanup notices first, then the source lines. */
+    static String report(List<String> cleanupNotices, List<String> sourceLines) {
+        StringBuilder out = new StringBuilder();
+        for (String s : cleanupNotices) out.append("[清理] ").append(sanitize(s)).append('\n');
+        for (String s : sourceLines) out.append(sanitize(s)).append('\n');
+        return out.toString();
+    }
+
+    static String line(String what, String value, String source, String detail) {
+        return "[来源] " + what + " = " + value + " ← " + source + (detail == null || detail.isEmpty() ? "" : "（" + detail + "）");
+    }
+
+    /** Mihomo / Mihomo Smart: SOURCE is the selected file (after reference cleanup), FINAL the generated copy. */
+    static List<String> mihomo(String source, String finalYaml, ProxyRuntimeProfile profile, int tproxyPort, int redirectPort,
+                               boolean dnsTakeover, int dnsPort, int controllerPort, boolean controllerReused,
+                               String fakeIpV4, String fakeIpV6) {
+        List<String> out = new ArrayList<>();
+        int sourceTp = MihomoStartupConfig.detectScalarPort(source, "tproxy-port");
+        int sourceRp = MihomoStartupConfig.detectScalarPort(source, "redir-port");
+        out.add(portLine("TPROXY 端口", tproxyPort, sourceTp, "tproxy-port", profile.mode.label));
+        out.add(portLine("Redirect 端口", redirectPort, sourceRp, "redir-port", profile.mode.label));
+        Map<String, Object> srcDns = dns(source), finalDns = dns(finalYaml);
+        String srcListen = scalar(srcDns, "listen");
+        if (dnsTakeover) {
+            out.add(line("DNS 监听", "127.0.0.1:" + dnsPort, SRC_HETU,
+                    srcListen.isEmpty() ? "配置文件未设置 dns.listen" : "配置文件的 dns.listen " + srcListen + " 不用于 Root 接管"));
+        } else {
+            out.add(line("DNS 监听", srcListen.isEmpty() ? "未设置" : srcListen, srcListen.isEmpty() ? SRC_DEFAULT : SRC_CONFIG, "DNS 接管已关闭"));
+        }
+        String srcMode = scalar(srcDns, "enhanced-mode"), finalMode = scalar(finalDns, "enhanced-mode");
+        boolean dnsEnabled = finalDns != null && !"false".equalsIgnoreCase(scalar(finalDns, "enable"));
+        if (finalDns == null) out.add(line("DNS 模式", "未启用内置 DNS", SRC_DEFAULT, "配置文件没有 dns 段"));
+        else if (!dnsEnabled) out.add(line("DNS 模式", "内置 DNS 已关闭", SRC_CONFIG, "dns.enable: false"));
+        else if (finalMode.isEmpty()) out.add(line("DNS 模式", "redir-host", SRC_DEFAULT, "配置文件未设置 dns.enhanced-mode，按 Mihomo 默认"));
+        else if (finalMode.equals(srcMode)) out.add(line("DNS 模式", finalMode, SRC_CONFIG, "dns.enhanced-mode"));
+        else out.add(line("DNS 模式", finalMode, SRC_HETU, srcMode.isEmpty() ? "配置文件未设置" : "配置文件为 " + srcMode));
+        boolean fakeIp = dnsEnabled && "fake-ip".equalsIgnoreCase(finalMode);
+        if (fakeIp) {
+            String srcRange = scalar(srcDns, "fake-ip-range");
+            String v4 = fakeIpV4 == null || fakeIpV4.isEmpty() ? "未使用" : fakeIpV4;
+            out.add(line("Fake-IP 范围（IPv4）", v4, srcRange.isEmpty() ? SRC_DEFAULT : SRC_CONFIG,
+                    srcRange.isEmpty() ? "配置文件未设置 dns.fake-ip-range" : "dns.fake-ip-range"));
+            String srcRange6 = scalar(srcDns, "fake-ip-range6");
+            if (fakeIpV6 != null && !fakeIpV6.isEmpty())
+                out.add(line("Fake-IP 范围（IPv6）", fakeIpV6, srcRange6.isEmpty() ? SRC_DEFAULT : SRC_CONFIG,
+                        srcRange6.isEmpty() ? "配置文件未设置 dns.fake-ip-range6" : "dns.fake-ip-range6"));
+        } else {
+            out.add(line("Fake-IP 范围", "未使用", finalDns == null || finalMode.isEmpty() ? SRC_DEFAULT : SRC_CONFIG, "DNS 模式不是 fake-ip"));
+        }
+        out.add(line("控制接口端口", "127.0.0.1:" + controllerPort, SRC_HETU, controllerReused ? "沿用当前运行的端口" : "启动时自动选择空闲端口"));
+        return out;
+    }
+
+    /** sing-box / Xray / V2Fly / Hysteria: Hetu owns every ingress; the fake-IP range comes from the source or a default. */
+    static List<String> nativeCore(String coreLabel, boolean nativeSource, String source, int tproxyPort, int redirectPort, int dnsPort,
+                                   int controllerPort, boolean controllerReused, String fakeIpV4) {
+        List<String> out = new ArrayList<>();
+        String taken = nativeSource ? "已接管 " + coreLabel + " 配置中的入站" : "由 Clash/Mihomo 配置转换";
+        out.add(tproxyPort > 0 ? line("TPROXY 端口", String.valueOf(tproxyPort), SRC_HETU, taken) : line("TPROXY 端口", "未启用", SRC_HETU, "当前模式不需要"));
+        out.add(redirectPort > 0 ? line("Redirect 端口", String.valueOf(redirectPort), SRC_HETU, taken) : line("Redirect 端口", "未启用", SRC_HETU, "当前模式不需要"));
+        out.add(dnsPort > 0 ? line("DNS 监听", "127.0.0.1:" + dnsPort, SRC_HETU, "河图 DNS 入站") : line("DNS 监听", "未启用", SRC_APP, "DNS 接管已关闭"));
+        if (fakeIpV4 == null || fakeIpV4.isEmpty()) {
+            out.add(line("Fake-IP 范围", "未使用", nativeSource ? SRC_CONFIG : SRC_DEFAULT, nativeSource ? "原生配置未声明河图可识别的 fake-IP" : "转换后的 DNS 不使用 fake-ip"));
+        } else {
+            String range = nativeSource ? "" : scalar(dns(source), "fake-ip-range");
+            boolean fromSource = !range.isEmpty();
+            out.add(line("Fake-IP 范围（IPv4）", fakeIpV4, fromSource ? SRC_CONFIG : SRC_DEFAULT,
+                    fromSource ? "dns.fake-ip-range" : "配置文件未设置，使用默认 " + ProxyCoreConfig.DEFAULT_FAKE_IP_V4));
+        }
+        out.add(controllerPort > 0 ? line("控制接口端口", "127.0.0.1:" + controllerPort, SRC_HETU, controllerReused ? "沿用当前运行的端口" : "启动时自动选择空闲端口")
+                : line("控制接口端口", "未启用", SRC_HETU, coreLabel + " 无控制接口"));
+        return out;
+    }
+
+    /** Comment header for the private startup copy; empty when no reference was cleaned. */
+    static String header(List<String> cleanupNotices) {
+        StringBuilder out = new StringBuilder();
+        int n = 0;
+        for (String s : cleanupNotices) {
+            if (n++ >= MAX_LINES) break;
+            out.append(NOTICE_PREFIX).append(sanitize("[清理] " + s)).append('\n');
+        }
+        return out.toString();
+    }
+
+    /** One line, no control characters, bounded; safe inside a YAML comment and a shell `sed`. */
+    static String sanitize(String s) {
+        StringBuilder b = new StringBuilder();
+        for (int i = 0; i < s.length() && b.length() < 400; i++) {
+            char c = s.charAt(i);
+            b.append(c < 0x20 || c == 0x7f || c == 0x2028 || c == 0x2029 ? ' ' : c);
+        }
+        return b.toString();
+    }
+
+    private static String portLine(String what, int port, int sourcePort, String key, String modeLabel) {
+        if (port <= 0) return line(what, "未启用", SRC_HETU, modeLabel + " 模式不需要" + (sourcePort > 0 ? "；配置文件的 " + key + ": " + sourcePort + " 已忽略" : ""));
+        return line(what, String.valueOf(port), SRC_HETU, sourcePort > 0 ? "配置文件的 " + key + ": " + sourcePort + " 已被替换" : "配置文件未设置 " + key);
+    }
+
+    static Map<String, Object> dns(String yaml) {
+        if (yaml == null || ProxyCoreConfig.looksJson(yaml) || !MihomoStartupConfig.hasTopLevelKey(yaml, "dns")) return null;
+        try {
+            Object root = ConfigReferenceCleaner.loader().load(yaml);
+            return root instanceof Map ? ConfigReferenceCleaner.map(((Map<?, ?>) root).get("dns")) : null;
+        } catch (YAMLException | ClassCastException invalid) {
+            return null;
+        }
+    }
+
+    static String scalar(Map<String, Object> m, String key) {
+        if (m == null) return "";
+        Object v = m.get(key);
+        return v == null || v instanceof Map || v instanceof List ? "" : String.valueOf(v).trim();
+    }
+}
