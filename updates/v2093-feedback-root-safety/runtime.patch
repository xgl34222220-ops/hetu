+internal fun formatMbps(value: Double): String = when {
+    value <= 0.0 -> "0"
+    value < 10 -> String.format(Locale.ROOT, "%.2f", value)
+    value < 100 -> String.format(Locale.ROOT, "%.1f", value)
+    else -> String.format(Locale.ROOT, "%.0f", value)
+}
