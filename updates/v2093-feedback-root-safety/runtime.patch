+  if [ "$CR_FAILED" = 0 ]; then printf '{"ok":true,"reloaded":true,"cnip":"iptables","message":"CNIP iptables 规则已热更新"}\n'
+  else printf '{"ok":false,"reloaded":false,"cnip":"iptables","message":"CNIP 新数据无效或规则更新失败，内核绕过可能暂时经核心处理"}\n'; fi
