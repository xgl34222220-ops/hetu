+            default: return "version";
+        }
+    }
+
+    // ------------------------------------------------------------------ options / result
+
+    interface Fetcher {
+        /** Returns the body of an HTTP(S) provider, or null when it cannot be fetched. */
+        String fetch(String url) throws IOException;
+    }
+
