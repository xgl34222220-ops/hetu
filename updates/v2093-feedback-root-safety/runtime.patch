+            emptyList(), emptyList(), emptyList(), emptyList(), mapOf("node" to 52L), mapOf("node" to true),
+            emptyMap(), emptyMap(), emptyMap(), PanelTrafficSnapshot(), testingGroups = setOf("Route"))
+        assertEquals(PanelDelay.Testing, data.delays["node"])
