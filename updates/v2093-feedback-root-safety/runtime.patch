+# ---- actions
+monitor_script_name_ok(){
+  case "$1" in ''|.*|*[!A-Za-z0-9._-]*|pre-start.sh|post-stop.sh) return 1;; *.sh|*.SH|*.Sh|*.sH) ;; *) return 1;; esac
+  [ "${#1}" -le 75 ]
