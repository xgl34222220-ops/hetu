+    static final Set<String> HYSTERIA_OWNED = new LinkedHashSet<>(Arrays.asList(
+            "socks5", "http", "tcpForwarding", "udpForwarding", "tcpTProxy", "udpTProxy", "tcpRedirect", "tun"));
