index 0000000..b4ef1da
--- /dev/null
+++ b/android-app/app/src/main/java/io/github/xgl34222220/hetu/app/HxDiagnosticsBundle.kt
@@ -0,0 +1,105 @@
+package io.github.xgl34222220.hetu
+
+import android.content.Context
+import android.net.Uri
+import android.os.Build
+import java.io.IOException
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/**
+ * func-400 D1: 工具 › 诊断与维护 › 导出诊断包.
+ *
+ * One text file with everything a network-loss / start-failure report needs: the existing
+ * 消息与网络诊断 report (already redacted), plus the self-heal state the watchdog keeps under
+ * /data/adb/hetu/run (watchdog.log, selfheal/egress/cgroup-escape state, Wi-Fi heal count), the
+ * policy-routing / iptables state and the core processes. Read-only: the Root command only reads
+ * files and lists rules; nothing is started, stopped or rewritten. Controller secret and full URLs
+ * are redacted with the same [DiagnosticReport.redact] as the on-screen report.
+ */
+internal object HxDiagnosticsBundle {
+    const val MIME = "text/plain"
+    private const val RUN = "/data/adb/hetu/run"
+    private const val ROOT_TIMEOUT_MS = 15_000L
+    private const val SECTION_LIMIT = 400_000
+
+    fun fileName(now: Long = System.currentTimeMillis()): String =
+        "hetu-diagnostics-" + SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(Date(now)) + ".txt"
+
+    /** The read-only Root script; every step tolerates a missing file or tool. */
+    val ROOT_COMMAND: String = listOf(
+        "R=$RUN",
+        "for f in start-state last-start-error last-crash selfheal-state egress-state cgroup-escape rollback-state " +
+            "network-repair-at sysctl-tune.state state/selfheal-budget state/wifi-reconnects state/core.kind; do " +
+            "echo \"--- \$f ---\"; cat \"\$R/\$f\" 2>/dev/null; echo; done",
+        "echo '--- watchdog.log (last 300 lines) ---'; tail -n 300 \"\$R/watchdog.log\" 2>/dev/null",
+        "echo '--- network-repair.log ---'; tail -n 60 \"\$R/network-repair.log\" 2>/dev/null",
+        "echo '--- ebpf.log ---'; tail -n 40 \"\$R/ebpf.log\" 2>/dev/null",
+        "echo '--- share.log ---'; tail -n 30 \"\$R/share.log\" 2>/dev/null",
+        "echo '--- core.log (last 200 lines) ---'; tail -n 200 \"\$R/core.log\" 2>/dev/null",
+        "echo '--- processes ---'; ps -A -o PID,PPID,STAT,NAME 2>/dev/null | grep -iE 'mihomo|clash|sing-box|xray|v2ray|hysteria|hetu' | grep -v grep",
+        "echo '--- ip rule ---'; ip rule show 2>/dev/null; echo '--- ip -6 rule ---'; ip -6 rule show 2>/dev/null",
+        "echo '--- ip route (policy tables) ---'; ip route show table all 2>/dev/null | grep -vE '^(local|broadcast) ' | head -n 120",
+        "echo '--- iptables mangle ---'; iptables-save -t mangle 2>/dev/null | head -n 260",
+        "echo '--- iptables nat ---'; iptables-save -t nat 2>/dev/null | head -n 200",
+        "echo '--- iptables filter (Hetu) ---'; iptables-save -t filter 2>/dev/null | grep -E 'HETU|BICHEN|^\\*|^:' | head -n 160",
+        "echo '--- ip6tables mangle ---'; ip6tables-save -t mangle 2>/dev/null | head -n 200",
+        "echo '--- ip6tables nat ---'; ip6tables-save -t nat 2>/dev/null | head -n 120",
+        "echo '--- connectivity ---'; dumpsys connectivity 2>/dev/null | grep -E 'NetworkAgentInfo|VALIDATED|PARTIAL_CONNECTIVITY|CAPTIVE|Active default network' | head -n 40",
+        "true",
+    ).joinToString("\n")
+
+    /** Device / App header; no identifiers beyond model and versions. */
+    fun header(context: Context, now: Long = System.currentTimeMillis()): String {
+        val version = "${BuildConfig.VERSION_NAME} (${BuildConfig.VERSION_CODE})"
+        return buildString {
+            append("河图诊断包 / Hetu diagnostics\n")
+            append("time=").append(SimpleDateFormat("yyyy-MM-dd HH:mm:ss Z", Locale.US).format(Date(now))).append('\n')
+            append("app=").append(version).append('\n')
+            append("device=").append(Build.MANUFACTURER).append(' ').append(Build.MODEL).append('\n')
+            append("android=").append(Build.VERSION.RELEASE).append(" (SDK ").append(Build.VERSION.SDK_INT).append(")\n")
+            append("abis=").append(Build.SUPPORTED_ABIS.joinToString(",")).append('\n')
+            append("note=密钥与完整 URL 已脱敏；包含本机 IP 与路由信息，分享前请确认\n")
+        }
+    }
+
+    /**
+     * Builds the bundle. [report] is the existing on-screen diagnostics; [rootRead] runs [ROOT_COMMAND]
+     * (replaceable in tests). A failing part is written as its error text, never aborting the bundle.
+     */
+    suspend fun build(
+        context: Context,
+        report: suspend () -> String,
+        rootRead: (String) -> String = { command -> readRoot(context, command) },
+    ): String = withContext(Dispatchers.IO) {
+        val secret = context.getSharedPreferences("hetu", Context.MODE_PRIVATE).getString("proxyControllerSecret", "").orEmpty()
+        val diagnostics = try { report() } catch (cancel: CancellationException) { throw cancel } catch (error: Exception) {
+            "读取失败：" + hxErrorMessage(error, "读取失败")
+        }
+        val selfHeal = try { rootRead(ROOT_COMMAND) } catch (cancel: CancellationException) { throw cancel } catch (error: Exception) {
+            "读取失败：" + hxErrorMessage(error, "读取失败")
+        }
+        buildString {
+            append(header(context)).append('\n')
+            append("===== 消息与网络诊断 =====\n")
+            append(DiagnosticReport.redact(diagnostics, secret).take(SECTION_LIMIT)).append("\n\n")
+            append("===== 看门狗 / 自愈 / 路由与防火墙状态 =====\n")
+            append(DiagnosticReport.redact(selfHeal, secret).take(SECTION_LIMIT)).append('\n')
+        }
+    }
+
+    private fun readRoot(context: Context, command: String): String {
+        val result = RootBridge.rootShell(context, command, ROOT_TIMEOUT_MS)
+        return if (result.ok()) result.output else "exit=${result.code}\n${result.output}"
+    }
+
+    /** Writes [text] to the document the user picked. */
+    suspend fun write(context: Context, uri: Uri, text: String) = withContext(Dispatchers.IO) {
+        val output = context.contentResolver.openOutputStream(uri, "wt") ?: throw IOException("无法写入导出文件")
+        output.use { it.write(text.toByteArray(Charsets.UTF_8)) }
+    }
+}
diff --git a/android-app/app/src/main/java/io/github/xgl34222220/hetu/app/HxDirectProbe.kt b/android-app/app/src/main/java/io/github/xgl34222220/hetu/app/HxDirectProbe.kt
new file mode 100644
index 0000000..96449d6
--- /dev/null
+++ b/android-app/app/src/main/java/io/github/xgl34222220/hetu/app/HxDirectProbe.kt
@@ -0,0 +1,68 @@
+package io.github.xgl34222220.hetu
+
+import android.content.Context
+import android.os.SystemClock
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+import java.net.HttpURLConnection
+import java.net.URL
+import kotlin.coroutines.coroutineContext
+
+/**
+ * 网络延迟 while the proxy is stopped: the same three targets over the device's ordinary route
+ * (what any other app gets with Hetu off). Deliberately separate from
+ * ProxyDashboardRepository.siteLatencies, whose runtime-bound probe identity stays untouched.
+ * Same timeouts and success rule ([hxProbeAnswered]) as that probe.
+ * Results: name → ms (> 0), -1 = failed or timed out.
+ */
+internal suspend fun hxDirectSiteLatencies(context: Context): Map<String, Long> = withContext(Dispatchers.IO) {
+    val sites = ProxyLatencyTargets.load(context.applicationContext)
+    coroutineScope {
+        sites.map { target -> async { target.name to hxDirectLatency(target.url) } }.awaitAll().toMap()
+    }
+}
+
+/**
+ * Whether [code] is a real answer from [url]. A generate_204 endpoint must answer 204: a captive
+ * portal, a DNS-hijack page or an interception box answers 200/302 for any host, which used to
+ * count as "reachable". Other targets accept 2xx/3xx as before.
+ */
+internal fun hxProbeAnswered(url: String, code: Int): Boolean {
+    val path = runCatching { URL(url).path.orEmpty() }.getOrDefault("")
+    return if (path.trimEnd('/').endsWith("generate_204")) code == 204 else code in 200..399
+}
+
+private suspend fun hxDirectLatency(url: String): Long {
+    coroutineContext.ensureActive()
+    return try {
+        val started = SystemClock.elapsedRealtime()
+        // The default route, not Proxy.NO_PROXY: a stopped Hetu measures exactly what other apps see.
+        val connection = (URL(url).openConnection() as HttpURLConnection).apply {
+            instanceFollowRedirects = true
+            useCaches = false
+            connectTimeout = 3_000
+            readTimeout = 3_000
+            requestMethod = "GET"
+            setRequestProperty("User-Agent", "Hetu-Android")
+            setRequestProperty("Cache-Control", "no-cache")
+        }
+        try {
+            val code = connection.responseCode
+            coroutineContext.ensureActive()
+            if (hxProbeAnswered(url, code)) (SystemClock.elapsedRealtime() - started).coerceAtLeast(1L) else -1L
+        } finally {
+            runCatching { connection.inputStream?.close() }
+            connection.disconnect()
+        }
+    } catch (cancel: CancellationException) {
+        throw cancel
+    } catch (_: Exception) {
+        coroutineContext.ensureActive()
+        -1L
+    }
+}
diff --git a/android-app/app/src/main/java/io/github/xgl34222220/hetu/app/HxFriendlyError.kt b/android-app/app/src/main/java/io/github/xgl34222220/hetu/app/HxFriendlyError.kt
new file mode 100644
index 0000000..231ea48
--- /dev/null
+++ b/android-app/app/src/main/java/io/github/xgl34222220/hetu/app/HxFriendlyError.kt
@@ -0,0 +1,77 @@
+package io.github.xgl34222220.hetu
+
+import java.io.FileNotFoundException
+import java.net.ConnectException
+import java.net.NoRouteToHostException
+import java.net.SocketTimeoutException
+import java.net.UnknownHostException
+import java.nio.file.AccessDeniedException
+import java.nio.file.NoSuchFileException
+import java.util.Locale
+import javax.net.ssl.SSLException
+
+/**
+ * A failure as the user should read it: a short Chinese phrase (a word-table key, so ht() can
+ * translate it), a stable reason code, and the original JVM text for the log / details.
+ *
+ * [code] is null when the message is already the App's own wording (any non-JVM failure): then
+ * [text] is that message unchanged and nothing is appended.
+ */
+internal data class HxFriendlyError(val text: String, val code: String?, val detail: String) {
+    /** What a toast or an inline error shows: the phrase, then the reason code. */
+    val display: String get() = if (code == null) text else "$text · $code"
+}
+
+private val hxHttpStatus = Regex("""(?:^|\s|：|:)HTTP(?:/\d(?:\.\d)?)?\s*[:：]?\s*([1-5]\d{2})(?!\d)""")
+
+/**
+ * Maps JVM network and I/O exceptions (UnknownHost, SocketTimeout, Connect, NoRouteToHost, SSL,
+ * FileNotFound/NoSuchFile, AccessDenied) and plain "HTTP 4xx/5xx" failures to a short phrase plus
+ * a reason code. Everything else keeps its own message (or [fallback] when it has none), so the
+ * App's existing Chinese errors are never rewritten.
+ */
+internal fun hxFriendlyError(error: Throwable, fallback: String): HxFriendlyError {
+    val raw = error.message?.trim().orEmpty()
+    val detail = (error::class.java.simpleName + if (raw.isEmpty()) "" else ": $raw")
+    fun mapped(text: String, code: String) = HxFriendlyError(text, code, detail)
+    // Wrapped exceptions (ExecutionException, IOException(cause)) report the innermost known type.
+    var cause: Throwable? = error
+    var depth = 0
+    while (cause != null && depth < 6) {
+        when (cause) {
+            is UnknownHostException -> return mapped("无法解析服务器地址，请检查网络或 DNS", "UNKNOWN_HOST")
+            is SocketTimeoutException -> return mapped("连接超时，请检查网络后重试", "TIMEOUT")
+            is NoRouteToHostException -> return mapped("网络不可达，请检查网络连接", "NO_ROUTE")
+            is ConnectException -> return mapped("无法连接服务器，请确认地址和端口", "CONNECT_FAILED")
+            is SSLException -> return mapped("安全连接失败，请检查系统时间或证书", "SSL")
+            is FileNotFoundException, is NoSuchFileException -> return mapped("文件不存在或无法访问", "FILE_NOT_FOUND")
+            is AccessDeniedException -> return mapped("没有访问权限", "ACCESS_DENIED")
+        }
+        cause = cause.cause?.takeIf { it !== cause }
+        depth++
+    }
+    // Only a bare status ("HTTP 404", "HTTP/1.1 503", "下载失败：HTTP 500") is mapped; App wording
+    // around it is kept as the detail.
+    hxHttpStatus.find(raw)?.groupValues?.get(1)?.toIntOrNull()?.let { status ->
+        val code = "HTTP_$status"
+        when {
+            status == 404 -> return mapped("地址不存在，请检查链接（HTTP 404）", code)
+            status == 429 -> return mapped("请求过于频繁，请稍后再试（HTTP 429）", code)
+            status in 400..499 -> return mapped("请求被拒绝，请检查链接或访问令牌（HTTP %s）".hxFill(status), code)
+            status in 500..599 -> return mapped("服务器出错，请稍后再试（HTTP %s）".hxFill(status), code)
+        }
+    }
+    return HxFriendlyError(raw.ifEmpty { fallback }, null, detail)
+}
+
+/** Short message for a toast or inline error; the original JVM text goes to the log. */
+internal fun hxErrorMessage(error: Throwable, fallback: String): String {
+    val friendly = hxFriendlyError(error, fallback)
+    if (friendly.code != null) {
+        // android.util.Log is a stub in plain JVM tests; logging must never mask the error itself.
+        runCatching { android.util.Log.w("Hetu", "${friendly.code}: ${friendly.detail}") }
+    }
+    return friendly.display
+}
+
+private fun String.hxFill(vararg args: Any): String = String.format(Locale.ROOT, this, *args)
