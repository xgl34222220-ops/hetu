+import androidx.compose.ui.graphics.vector.ImageVector
+import androidx.compose.ui.graphics.vector.addPathNodes
+import androidx.compose.ui.unit.dp
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Brand marks of 网络测试, bundled as vector path data: nothing is downloaded at runtime.
+ * Paths and brand colours are from Simple Icons 16.34.0 (CC0 1.0, https://simpleicons.org);
+ * the marks remain the trademarks of their owners and are only used to label each service.
+ * Services Simple Icons does not carry are drawn as a lettered tile instead (see [NetBrand.mark]).
+ */
+internal object NetBrandIcons {
+    private val built = ConcurrentHashMap<String, ImageVector>()
+
+    /** Monochrome mark for [slug] (tinted when drawn); null when the service has no bundled mark. */
+    fun vector(slug: String): ImageVector? {
+        val path = paths[slug] ?: return null
+        return built.getOrPut(slug) {
+            ImageVector.Builder(name = "brand-$slug", defaultWidth = 24.dp, defaultHeight = 24.dp, viewportWidth = 24f, viewportHeight = 24f)
+                .addPath(pathData = addPathNodes(path), fill = SolidColor(Color.Black))
+                .build()
+        }
+    }
+
+    /** Simple Icons brand colours, ARGB. */
+    val colors: Map<String, Long> = mapOf(
+        "claude" to 0xFFD97757L,
+        "googlegemini" to 0xFF8E75B2L,
+        "discord" to 0xFF5865F2L,
+        "tiktok" to 0xFF000000L,
+        "reddit" to 0xFFFF4500L,
+        "x" to 0xFF000000L,
+        "telegram" to 0xFF26A5E4L,
+        "appletv" to 0xFF000000L,
+        "bilibili" to 0xFF00A1D6L,
+        "netflix" to 0xFFE50914L,
+        "spotify" to 0xFF1ED760L,
+        "twitch" to 0xFF9146FFL,
+        "youtube" to 0xFFFF0000L,
+        "alibabadotcom" to 0xFFFF6A00L,
+        "apple" to 0xFF000000L,
+        "cloudflare" to 0xFFF38020L,
+        "github" to 0xFF181717L,
+        "paypal" to 0xFF002991L,
+        "steam" to 0xFF000000L,
+        "wikipedia" to 0xFF000000L,
+        "google" to 0xFF4285F4L,
+        "baidu" to 0xFF2932E1L,
+    )
