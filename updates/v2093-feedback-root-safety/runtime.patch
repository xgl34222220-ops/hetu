+        assertEquals("current", vm.coreVersion)
+    }
+
+    @Test fun olderResourceSampleCannotOverwriteANewerConfirmedProcess() {
+        PanelActionRuntimeShadows.RuntimeSample.pause = true
+        val old = refresh()
