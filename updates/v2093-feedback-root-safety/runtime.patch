+  if [ "${1:-}" = -t ] && [ -n "${2:-}" ]; then XR_T="$2"; else XR_T=""; fi
+  case "$XR_T:${3:-}" in mangle:-N|mangle:-A|mangle:-I|nat:-N|nat:-A|nat:-I|filter:-N|filter:-A|filter:-I) ;;
+    *)
