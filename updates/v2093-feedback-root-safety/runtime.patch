+      if ! has "$XB_RESTORE" || ! transaction_current; then XB_RC=1; break 2; fi
+      { printf '*%s\n' "$XB_T"; cat "$XB_FILE"; printf 'COMMIT\n'; } | xt_restore "$XB_RESTORE" >/dev/null 2>&1 || { XB_RC=1; break 2; }
