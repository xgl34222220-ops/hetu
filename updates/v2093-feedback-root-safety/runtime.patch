+        return JSONObject().put("ok", startSucceeds).put("running", startSucceeds).put("message", "fixture-permanently-dead")
+    }
+
+    @Implementation(methodName = "networkHealth")
+    private fun networkHealth(): JSONObject = JSONObject().put("ok", true)
