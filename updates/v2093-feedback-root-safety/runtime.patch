+        vm.prefs.edit().putBoolean("proxyCustomDelayUrlEnabled", true)
+            .putString("proxyCustomDelayUrl", "https://new.invalid/204").commit()
+        held.countDown(); awaitActions()
+        assertNull(failure)
+        assertTrue(done)
+    }
+}
