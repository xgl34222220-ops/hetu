+    /** Never a tether ingress: cellular, loopback and virtual links (also the Root script refuses them). */
+    private static final Pattern NEVER_SHARED = Pattern.compile("(lo|rmnet|ccmni|dummy|tun|hetu|ifb|ip6tnl|sit).*");
+
+    static String mode(String raw) { return "only".equals(raw == null ? "" : raw.trim()) ? "only" : "direct"; }
+
+    static String sanitizeInterfaces(Collection<String> values) throws IOException {
+        if (values == null || values.isEmpty()) return "";
+        LinkedHashSet<String> out = new LinkedHashSet<>();
+        TreeSet<String> sorted = new TreeSet<>();
+        for (String raw : nonNull(values)) sorted.add(raw.trim());
+        for (String value : sorted) {
+            if (value.isEmpty()) continue;
+            if (!IFACE_SAFE.matcher(value).matches()) throw new IOException("共享接口名无效：" + value);
+            if (NEVER_SHARED.matcher(value).matches()) throw new IOException("不能把 " + value + " 作为共享接口：蜂窝 / 回环 / 虚拟接口不是热点入口");
+            out.add(value);
+        }
+        if (out.size() > MAX_INTERFACES) throw new IOException("共享接口最多 " + MAX_INTERFACES + " 个");
+        return String.join(",", out);
+    }
+
+    static String sanitizeMacs(Collection<String> values) throws IOException {
+        if (values == null || values.isEmpty()) return "";
+        TreeSet<String> out = new TreeSet<>();
+        for (String raw : nonNull(values)) {
+            String value = raw.trim().toLowerCase(Locale.ROOT);
+            if (value.isEmpty()) continue;
+            if (!MAC_SAFE.matcher(value).matches()) throw new IOException("MAC 地址无效：" + value);
+            if (value.equals("00:00:00:00:00:00") || value.equals("ff:ff:ff:ff:ff:ff")) throw new IOException("不能使用全零或广播 MAC：" + value);
+            out.add(value);
+        }
+        if (out.size() > MAX_MACS) throw new IOException("共享网络 MAC 白名单超过 " + MAX_MACS + " 项");
+        return String.join(",", out);
+    }
+
+    /**
+     * Body of $BASE/policy/share, or "" when nothing is scoped (no interface and blacklist mode):
+     * the Root script then keeps the legacy, unscoped shared chains.
+     */
+    static String policyBody(Collection<String> interfaces, String macMode, Collection<String> onlyMacs) throws IOException {
+        String ifaces = sanitizeInterfaces(interfaces);
+        String mode = mode(macMode);
+        String macs = "only".equals(mode) ? sanitizeMacs(onlyMacs) : "";
+        if (ifaces.isEmpty() && "direct".equals(mode)) return "";
+        return "IFACES=" + ifaces + "\nMODE=" + mode + "\nMACS=" + macs + "\n";
+    }
+
+    /** A candidate for the shared-interface list: tether-like name, not cellular/virtual, not the upstream. */
+    static boolean tetherCandidate(String name, Collection<String> upstream, Collection<String> tethered) {
+        if (name == null || name.isEmpty() || NEVER_SHARED.matcher(name).matches()) return false;
+        if (upstream != null && upstream.contains(name)) return false;
+        if (tethered != null && tethered.contains(name)) return true;
+        return TETHER_NAME.matcher(name).matches();
+    }
+
+    /** `ip route get` output -> the "dev" interface (upstream), or "". */
+    static String routeDevice(String output) {
+        if (output == null) return "";
+        String[] words = output.trim().split("\\s+");
+        for (int i = 0; i + 1 < words.length; i++) if (words[i].equals("dev")) return words[i + 1];
+        return "";
+    }
+
+    /** Interfaces reported as tethered by `dumpsys tethering` / `dumpsys connectivity` (best effort). */
+    static Set<String> tetheredInterfaces(String dumpsys) {
+        TreeSet<String> out = new TreeSet<>();
+        if (dumpsys == null) return out;
+        for (String line : dumpsys.split("\\r?\\n")) {
+            String t = line.trim();
+            // "wlan2 - TetheredState - lastError = 0" / "rndis0 - TETHERED" / "Tethered: [ap0, rndis0]"
+            int dash = t.indexOf(" - ");
+            if (dash > 0 && t.substring(dash).toLowerCase(Locale.ROOT).contains("tethered") && !t.toLowerCase(Locale.ROOT).contains("untethered")) {
+                String name = t.substring(0, dash).trim();
+                if (IFACE_SAFE.matcher(name).matches()) out.add(name);
+            }
+            if (t.startsWith("Tethered") && t.contains("[")) {
+                String inner = t.substring(t.indexOf('[') + 1, t.indexOf(']') > 0 ? t.indexOf(']') : t.length());
+                for (String n : inner.split("[,\\s]+")) if (IFACE_SAFE.matcher(n.trim()).matches()) out.add(n.trim());
+            }
+        }
+        return out;
+    }
+
+    /** One DHCP lease: dnsmasq format "expiry mac ip hostname client-id". */
+    static final class Lease {
+        final String mac, ip, hostname;
+        Lease(String mac, String ip, String hostname) { this.mac = mac; this.ip = ip; this.hostname = hostname; }
+    }
+
+    static List<Lease> parseLeases(String text) {
+        ArrayList<Lease> out = new ArrayList<>();
+        if (text == null) return out;
+        for (String line : text.split("\\r?\\n")) {
+            String[] w = line.trim().split("\\s+");
+            if (w.length < 3 || !w[0].matches("[0-9]+")) continue;
+            String mac = w[1].toLowerCase(Locale.ROOT);
+            if (!MAC_SAFE.matcher(mac).matches() || !w[2].matches("[0-9A-Fa-f:.]{2,64}")) continue;
+            String host = w.length > 3 && !w[3].equals("*") ? w[3].replaceAll("[^A-Za-z0-9._-]", "") : "";
+            out.add(new Lease(mac, w[2], host.length() > 63 ? host.substring(0, 63) : host));
+        }
+        return out;
+    }
+
+    private static List<String> nonNull(Collection<String> values) {
+        ArrayList<String> out = new ArrayList<>();
+        for (String v : values) if (v != null) out.add(v);
+        return out;
+    }
+}
diff --git a/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartPrelude.java b/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartPrelude.java
new file mode 100644
index 0000000..bb43799
--- /dev/null
+++ b/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartPrelude.java
@@ -0,0 +1,95 @@
+package io.github.xgl34222220.hetu;
+
+/**
+ * Shell fragments that let a manual start run in ONE Root invocation: cancellation receipt,
+ * optional pre-start hook, file deployment, then `exec hetu-root.sh start`.
+ *
+ * Every fragment either falls through to the next one or prints a single refusal line
+ * ({@link #ABORT}) and exits before the native transaction is dispatched, so the caller knows
+ * nothing native ran. Pure Java (no Android API) so it is host-testable.
+ */
+final class StartPrelude {
+    private StartPrelude() {}
+
+    static final String ABORT = "HETU_PRENATIVE";
+    static final String SCRIPT_DIR = "/data/adb/hetu/scripts";
+    static final String PRE_START = SCRIPT_DIR + "/pre-start.sh";
+    static final String SCRIPT_LOG = "/data/adb/hetu/run/scripts.log";
+
+    /**
+     * Reads hetu-root.sh's cancellation marker first thing in the start shell and exports it
+     * exactly like the former separate read: empty, or "digits-digits" of at most 64 chars.
+     */
+    static String cancelReceipt(String markerPath) {
+        String m = quote(markerPath);
+        return "hetu_t=''; if [ -e " + m + " ]; then hetu_t=$(cat " + m + ") || { printf '" + ABORT + "\\ttoken\\n'; exit 0; }; fi; "
+                + "case \"$hetu_t\" in '') ;; *[!0-9-]*|-*|*-|*-*-*) printf '" + ABORT + "\\ttoken\\n'; exit 0;; *-*) ;; "
+                + "*) printf '" + ABORT + "\\ttoken\\n'; exit 0;; esac; "
+                + "[ \"${#hetu_t}\" -le 64 ] || { printf '" + ABORT + "\\ttoken\\n'; exit 0; }; "
+                + "export HETU_START_CANCEL_TOKEN=\"$hetu_t\"; ";
+    }
+
+    /**
+     * The pre-start hook, same environment, log and 12 s limit as ProxyScriptHooks.run, but
+     * without any extra Root shell: when no hook exists this is one `[ -s ]` test.
+     */
+    static String preStartHook(String mode, String config) {
+        String path = quote(PRE_START);
+        return "if [ -s " + path + " ]; then ( "
+                + "mkdir -p " + quote(SCRIPT_DIR) + " /data/adb/hetu/run && chmod 700 " + quote(SCRIPT_DIR) + " || exit 45; "
+                + "export HETU_HOOK='pre-start'; "
+                + "export HETU_MODE=" + quote(mode) + "; "
+                + "export HETU_CONFIG=" + quote(config) + "; "
+                + "export HETU_BASE=/data/adb/hetu; "
+                + "export HETU_RUN_DIR=/data/adb/hetu/run; "
+                + "export HETU_SCRIPT_DIR=" + quote(SCRIPT_DIR) + "; "
+                + "{ printf '\\n[%s] hook=%s mode=%s config=%s\\n' \"$(date '+%Y-%m-%d %H:%M:%S')\" 'pre-start' "
+                + quote(mode) + " " + quote(config) + "; "
+                + "if command -v timeout >/dev/null 2>&1; then timeout 12 sh " + path + "; else sh " + path + "; fi; "
+                + "} >> " + quote(SCRIPT_LOG) + " 2>&1 ); hetu_h=$?; "
+                + "[ \"$hetu_h\" = 0 ] || { printf '" + ABORT + "\\thook\\t%s\\n' \"$hetu_h\"; exit 0; }; fi; ";
+    }
+
+    /** RootProxyManager's deployment command in its own `sh -c`, so its `set -e` really applies. */
+    static String deployment(String command) {
+        return "hetu_d=$(sh -c " + quote(command) + " 2>&1); hetu_rc=$?; "
+                + "if [ \"$hetu_rc\" != 0 ]; then printf '" + ABORT + "\\tdeploy\\t%s\\n' "
+                + "\"$(printf '%s' \"$hetu_d\" | tr '\\r\\n\\t' '   ' | head -c 300)\"; exit 0; fi; ";
+    }
+
+    /** Settings.Global private_dns_mode as hetu-root.sh's whitelist understands it. */
+    static String privateDnsMode(String raw) {
+        String value = raw == null ? "" : raw.trim();
+        switch (value) {
+            case "off": case "opportunistic": case "hostname": return value;
+            default: return "unknown";
+        }
+    }
+
+    /** The user-facing reason when the prelude refused before the native start, else null. */
+    static String refusal(String output) {
+        if (output == null) return null;
+        String text = output.trim();
+        int line = text.lastIndexOf('\n');
+        String last = (line >= 0 ? text.substring(line + 1) : text).trim();
+        if (!last.startsWith(ABORT + "\t")) return null;
+        String[] parts = last.split("\t", 3);
+        String kind = parts.length > 1 ? parts[1] : "";
+        String detail = parts.length > 2 ? parts[2].trim() : "";
+        switch (kind) {
+            case "token": return "无法确认启动撤销代次，已拒绝启动";
+            case "hook":
+                if ("124".equals(detail)) return "脚本执行超时，已停止本次操作";
+                if ("45".equals(detail)) return "无法创建脚本目录";
+                return "脚本执行失败（" + (detail.matches("[0-9]{1,3}") ? detail : "?") + "），请查看 scripts.log";
+            case "deploy": return "无法安装 Root 运行文件：" + (detail.isEmpty() ? "未知 Root 错误" : detail);
+            default: return "启动前准备未完成，已拒绝启动";
+        }
+    }
+
+    static String quote(String value) {
+        if (value == null) value = "";
+        if (value.indexOf('\0') >= 0) throw new IllegalArgumentException("Invalid shell value");
+        return "'" + value.replace("'", "'\\''") + "'";
+    }
+}
diff --git a/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartupConfigViewer.kt b/android-app/app/src/main/java/io/github/xgl34222220/hetu/StartupConfigViewer.kt
