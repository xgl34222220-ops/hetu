+    private static Map<String, Object> ruleSet(Map<String, Object> config, String tag) {
+        for (Object o : list(map(config.get("route")).get("rule_set"))) if (tag.equals(map(o).get("tag"))) return map(o);
+        fail("rule_set " + tag + " missing");
+        return null;
+    }
