+        assertEquals((SpeedTestHistory.MAX_RUNS + 5).toLong(), runs.first().nodes.single().delayMs)
+        SpeedTestHistory.delete(context, runs.first().id)
+        assertEquals(SpeedTestHistory.MAX_RUNS - 1, SpeedTestHistory.load(context).size)
