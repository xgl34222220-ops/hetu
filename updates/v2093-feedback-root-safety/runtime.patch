+  if { core_maybe_alive "$SHH_PID" && kill -0 "$SHH_PID" >/dev/null 2>&1; } || findcorepid >/dev/null 2>&1; then release_lock; return 1; fi
+  shield_run status_heal_body; SHH_RC=$?
+  release_lock
+  return "$SHH_RC"
