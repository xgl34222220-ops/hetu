+package io.github.xgl34222220.hetu;
+
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.util.*;
+
+/**
+ * Small deterministic JSON reader/writer for the non-Mihomo core configs (sing-box, Xray, V2Fly).
+ * Pure JVM (no org.json), so conversions are unit tested byte for byte against golden files.
+ * The reader accepts the comments Xray/V2Ray/sing-box accept in their JSON (//, /* *&#47; and #).
+ */
+final class CoreJson {
+    private CoreJson() {}
+
+    static final int MAX_DEPTH = 64;
+
+    // ---------------------------------------------------------------- writer
+
+    static String write(Object value) {
+        StringBuilder out = new StringBuilder(4096);
+        write(out, value, 0);
+        out.append('\n');
+        return out.toString();
+    }
+
+    private static void indent(StringBuilder out, int level) {
+        for (int i = 0; i < level; i++) out.append("  ");
+    }
+
+    @SuppressWarnings("unchecked")
+    private static void write(StringBuilder out, Object value, int level) {
+        if (value == null) { out.append("null"); return; }
+        if (value instanceof String) { string(out, (String) value); return; }
+        if (value instanceof Boolean) { out.append(((Boolean) value) ? "true" : "false"); return; }
+        if (value instanceof Integer || value instanceof Long || value instanceof Short || value instanceof Byte) {
+            out.append(((Number) value).longValue()); return;
+        }
+        if (value instanceof Number) {
+            double d = ((Number) value).doubleValue();
+            if (d == Math.rint(d) && !Double.isInfinite(d) && Math.abs(d) < 1e15) out.append((long) d);
+            else out.append(new BigDecimal(value.toString()).stripTrailingZeros().toPlainString());
+            return;
+        }
+        if (value instanceof Map) {
+            Map<String, Object> map = (Map<String, Object>) value;
+            if (map.isEmpty()) { out.append("{}"); return; }
+            out.append("{\n");
+            int i = 0;
+            for (Map.Entry<String, Object> e : map.entrySet()) {
+                indent(out, level + 1);
+                string(out, String.valueOf(e.getKey()));
+                out.append(": ");
+                write(out, e.getValue(), level + 1);
+                if (++i < map.size()) out.append(',');
+                out.append('\n');
+            }
+            indent(out, level);
+            out.append('}');
+            return;
+        }
+        if (value instanceof Collection) {
+            Collection<Object> list = (Collection<Object>) value;
+            if (list.isEmpty()) { out.append("[]"); return; }
+            boolean scalars = true;
+            for (Object o : list) if (o instanceof Map || o instanceof Collection) { scalars = false; break; }
+            if (scalars && list.size() <= 8) {
+                out.append('[');
+                int i = 0;
+                for (Object o : list) { if (i++ > 0) out.append(", "); write(out, o, level + 1); }
+                out.append(']');
+                return;
+            }
+            out.append("[\n");
+            int i = 0;
+            for (Object o : list) {
+                indent(out, level + 1);
+                write(out, o, level + 1);
+                if (++i < list.size()) out.append(',');
+                out.append('\n');
+            }
+            indent(out, level);
+            out.append(']');
+            return;
+        }
+        string(out, String.valueOf(value));
+    }
+
+    static void string(StringBuilder out, String s) {
+        out.append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            switch (c) {
+                case '"': out.append("\\\""); break;
+                case '\\': out.append("\\\\"); break;
+                case '\n': out.append("\\n"); break;
+                case '\r': out.append("\\r"); break;
+                case '\t': out.append("\\t"); break;
+                case '\b': out.append("\\b"); break;
+                case '\f': out.append("\\f"); break;
+                default:
+                    if (c < 0x20 || c == 0x2028 || c == 0x2029) out.append(String.format(Locale.ROOT, "\\u%04x", (int) c));
+                    else out.append(c);
+            }
+        }
+        out.append('"');
+    }
+
+    // ---------------------------------------------------------------- reader
+
+    static Object parse(String text) throws IOException {
+        if (text == null) throw new IOException("JSON 为空");
+        Reader r = new Reader(text);
+        r.ws();
+        Object v = r.value(0);
+        r.ws();
+        if (!r.end()) throw r.error("JSON 末尾有多余内容");
+        return v;
+    }
+
+    @SuppressWarnings("unchecked")
+    static Map<String, Object> parseObject(String text) throws IOException {
+        Object v = parse(text);
+        if (!(v instanceof Map)) throw new IOException("JSON 根节点应为对象");
+        return (Map<String, Object>) v;
+    }
+
+    private static final class Reader {
+        final String s; int p;
+        Reader(String s) { this.s = s; }
+        boolean end() { return p >= s.length(); }
+        IOException error(String m) {
+            int line = 1;
+            for (int i = 0; i < Math.min(p, s.length()); i++) if (s.charAt(i) == '\n') line++;
+            return new IOException(m + "（第 " + line + " 行）");
+        }
+        void ws() throws IOException {
+            while (p < s.length()) {
+                char c = s.charAt(p);
+                if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\uFEFF') { p++; continue; }
+                if (c == '#') { while (p < s.length() && s.charAt(p) != '\n') p++; continue; }
+                if (c == '/' && p + 1 < s.length()) {
+                    char n = s.charAt(p + 1);
+                    if (n == '/') { while (p < s.length() && s.charAt(p) != '\n') p++; continue; }
+                    if (n == '*') {
+                        int close = s.indexOf("*/", p + 2);
+                        if (close < 0) throw error("JSON 注释未闭合");
+                        p = close + 2; continue;
+                    }
+                }
+                break;
+            }
+        }
+        Object value(int depth) throws IOException {
+            if (depth > MAX_DEPTH) throw error("JSON 嵌套过深");
+            if (end()) throw error("JSON 提前结束");
+            char c = s.charAt(p);
+            if (c == '{') return object(depth);
+            if (c == '[') return array(depth);
+            if (c == '"') return str();
+            if (s.startsWith("true", p)) { p += 4; return Boolean.TRUE; }
+            if (s.startsWith("false", p)) { p += 5; return Boolean.FALSE; }
+            if (s.startsWith("null", p)) { p += 4; return null; }
+            if (c == '-' || (c >= '0' && c <= '9')) return number();
+            throw error("JSON 语法错误");
+        }
+        Map<String, Object> object(int depth) throws IOException {
+            LinkedHashMap<String, Object> map = new LinkedHashMap<>();
+            p++; ws();
+            if (!end() && s.charAt(p) == '}') { p++; return map; }
+            while (true) {
+                ws();
+                if (end() || s.charAt(p) != '"') throw error("JSON 对象键应为字符串");
+                String key = str();
+                ws();
+                if (end() || s.charAt(p) != ':') throw error("JSON 缺少冒号");
+                p++; ws();
+                map.put(key, value(depth + 1));
+                ws();
+                if (end()) throw error("JSON 对象未闭合");
+                char c = s.charAt(p);
+                if (c == ',') { p++; ws(); if (!end() && s.charAt(p) == '}') { p++; return map; } continue; }
+                if (c == '}') { p++; return map; }
+                throw error("JSON 对象语法错误");
+            }
+        }
+        List<Object> array(int depth) throws IOException {
+            ArrayList<Object> list = new ArrayList<>();
+            p++; ws();
+            if (!end() && s.charAt(p) == ']') { p++; return list; }
+            while (true) {
+                ws();
+                list.add(value(depth + 1));
+                ws();
+                if (end()) throw error("JSON 数组未闭合");
+                char c = s.charAt(p);
+                if (c == ',') { p++; ws(); if (!end() && s.charAt(p) == ']') { p++; return list; } continue; }
+                if (c == ']') { p++; return list; }
+                throw error("JSON 数组语法错误");
+            }
+        }
+        String str() throws IOException {
+            StringBuilder b = new StringBuilder();
+            p++;
+            while (true) {
+                if (end()) throw error("JSON 字符串未闭合");
+                char c = s.charAt(p++);
+                if (c == '"') return b.toString();
+                if (c != '\\') { b.append(c); continue; }
+                if (end()) throw error("JSON 转义未完成");
+                char e = s.charAt(p++);
+                switch (e) {
+                    case '"': b.append('"'); break;
+                    case '\\': b.append('\\'); break;
+                    case '/': b.append('/'); break;
+                    case 'b': b.append('\b'); break;
+                    case 'f': b.append('\f'); break;
+                    case 'n': b.append('\n'); break;
+                    case 'r': b.append('\r'); break;
+                    case 't': b.append('\t'); break;
+                    case 'u':
+                        if (p + 4 > s.length()) throw error("JSON \\u 转义无效");
+                        try { b.append((char) Integer.parseInt(s.substring(p, p + 4), 16)); }
+                        catch (NumberFormatException x) { throw error("JSON \\u 转义无效"); }
+                        p += 4; break;
+                    default: throw error("JSON 转义无效");
+                }
+            }
+        }
+        Object number() throws IOException {
+            int start = p;
+            if (s.charAt(p) == '-') p++;
+            while (p < s.length() && "0123456789.eE+-".indexOf(s.charAt(p)) >= 0) p++;
+            String t = s.substring(start, p);
+            try {
+                if (t.indexOf('.') < 0 && t.indexOf('e') < 0 && t.indexOf('E') < 0) {
+                    long l = Long.parseLong(t);
+                    if (l >= Integer.MIN_VALUE && l <= Integer.MAX_VALUE) return (int) l;
+                    return l;
+                }
+                return Double.parseDouble(t);
+            } catch (NumberFormatException x) { throw error("JSON 数字无效"); }
+        }
+    }
+}
diff --git a/android-app/app/src/main/java/io/github/xgl34222220/hetu/CoreResourceLimits.java b/android-app/app/src/main/java/io/github/xgl34222220/hetu/CoreResourceLimits.java
new file mode 100644
index 0000000..b231fee
--- /dev/null
+++ b/android-app/app/src/main/java/io/github/xgl34222220/hetu/CoreResourceLimits.java
@@ -0,0 +1,60 @@
+package io.github.xgl34222220.hetu;
+
+import java.util.Locale;
+
+/**
+ * 资源限制 → cgroup 硬限制 (default off). The existing memory limit (GOMEMLIMIT, a soft Go GC target)
+ * and I/O priority (ionice) stay as they are; when this switch is on, the same values are also enforced
+ * by the kernel: memcg {@code memory.max} and an I/O weight, cgroup v2 first with a v1 fallback
+ * ({@code memory.limit_in_bytes} / {@code blkio.weight}). hetu-root.sh reports what applied in
+ * tuning-status and core.log; a partial failure only warns. Pure JVM.
+ */
+final class CoreResourceLimits {
+    private CoreResourceLimits() {}
+
+    static final String PREF_ENABLED = "proxyCgroupLimitEnabled";
+    static final String PREFIX = "cg:";
+
+    /** The start argument: VALUE unchanged when off or empty, "cg:VALUE" when the cgroup switch is on. */
+    static String argument(String value, boolean cgroup) {
+        String v = value == null ? "" : value.trim();
+        if (v.isEmpty() || !cgroup) return v;
+        return v.startsWith(PREFIX) ? v : PREFIX + v;
+    }
+
+    /** cgroup v2 io.weight for an ionice best-effort level 0-7 (0 = highest): 200 … 25, default 100 at level 4. */
+    static int ioWeightV2(int level) { return (8 - clamp(level)) * 25; }
+
+    /** cgroup v1 blkio.weight for the same level: 1000 … 125, default 500 at level 4. */
+    static int blkioWeightV1(int level) { return (8 - clamp(level)) * 125; }
+
+    private static int clamp(int level) { return Math.max(0, Math.min(7, level)); }
+
+    /** Readable summary of a tuning-status line, e.g. "memcg=v2:268435456 iocg=failed". */
+    static String describe(String tuningStatus) {
+        if (tuningStatus == null || tuningStatus.trim().isEmpty() || "none".equals(tuningStatus.trim())) return "";
+        StringBuilder out = new StringBuilder();
+        for (String part : tuningStatus.trim().split("\\s+")) {
+            String text = null;
+            if (part.startsWith("memcg=v2:") || part.startsWith("memcg=v1:")) {
+                text = "内存硬限制（cgroup " + part.substring(6, 8) + "）" + mib(part.substring(9));
+            } else if (part.equals("memcg=failed")) {
+                text = "内存硬限制未生效（设备不支持 memcg）";
+            } else if (part.startsWith("iocg=v2:") || part.startsWith("iocg=v1:")) {
+                text = "I/O 权重（cgroup " + part.substring(5, 7) + "）" + part.substring(8);
+            } else if (part.equals("iocg=failed")) {
+                text = "I/O 权重未生效（设备不支持 io/blkio 控制器）";
+            }
+            if (text != null) out.append(out.length() == 0 ? "" : "；").append(text);
+        }
+        return out.toString();
+    }
+
+    private static String mib(String bytes) {
+        try {
+            return String.format(Locale.ROOT, " %d MiB", Long.parseLong(bytes) / (1024L * 1024L));
+        } catch (NumberFormatException invalid) {
+            return " " + bytes;
+        }
+    }
+}
diff --git a/android-app/app/src/main/java/io/github/xgl34222220/hetu/DaemonMonitorPolicy.java b/android-app/app/src/main/java/io/github/xgl34222220/hetu/DaemonMonitorPolicy.java
new file mode 100644
index 0000000..fa5d493
--- /dev/null
+++ b/android-app/app/src/main/java/io/github/xgl34222220/hetu/DaemonMonitorPolicy.java
@@ -0,0 +1,227 @@
+package io.github.xgl34222220.hetu;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.zip.CRC32;
+
+/**
+ * Pure rules of the Root monitor daemon (no Android API, host-tested): the policy file the App
+ * exports to {@code $BASE/policy/monitor}, the {@code monitor-status} reply, the daemon's App
+ * hand-off (stop / switch config) and the traffic batches handed out by {@code traffic-take}.
+ *
+ * <p>The daemon (hetu-root.sh monitor) runs only while a Root session runs. It evaluates network
+ * match itself (same OR semantics as {@link NetworkMatchRules}), runs network scripts itself, and
+ * wakes the App service for the actions that change App-owned intent. It also polls the core's
+ * Clash API and aggregates traffic per minute by app / host / destination IP / outbound / rule.
+ */
+final class DaemonMonitorPolicy {
+    private DaemonMonitorPolicy() {}
+
+    static final String POLICY_PATH = "/data/adb/hetu/policy/monitor";
+    static final String ACTION_DAEMON = "io.github.xgl34222220.hetu.DAEMON_NETWORK_ACTION";
+    static final int DEFAULT_INTERVAL_SECONDS = 5;
+    static final int MAX_LIST = 64;
+    static final long HANDOFF_MAX_AGE_MS = 60_000L;
+    static final String[] DIMENSIONS = {"app", "host", "ip", "outbound", "rule"};
+
+    // ------------------------------------------------------------------ policy body
+    static final class Inputs {
+        boolean traffic, netmatch, mobile;
+        int intervalSeconds = DEFAULT_INTERVAL_SECONDS, apiPort;
+        String apiSecret = "", matchAction = "start", unmatchAction = "none", mode = "", config = "";
+        Collection<String> ssids = Collections.emptyList(), bssids = Collections.emptyList(),
+                slots = Collections.emptyList(), mccMncs = Collections.emptyList();
+    }
+
+    /**
+     * Line-oriented body ("KEY=value", list keys repeated). Values carrying control characters are
+     * dropped, never escaped, so a crafted SSID or secret cannot add a line. A secret that cannot be
+     * written disables traffic instead of polling unauthenticated. GEN identifies the content.
+     */
+    static String body(Inputs in) {
+        StringBuilder lines = new StringBuilder();
+        boolean traffic = in.traffic && in.apiPort >= 1 && in.apiPort <= 65535;
+        String secret = in.apiSecret == null ? "" : in.apiSecret;
+        if (!lineSafe(secret) || secret.length() > 256) traffic = false;
+        int interval = Math.max(3, Math.min(60, in.intervalSeconds));
+        append(lines, "VERSION", "1");
+        append(lines, "TRAFFIC", traffic ? "1" : "0");
+        append(lines, "TRAFFIC_INTERVAL", Integer.toString(interval));
+        append(lines, "API_PORT", traffic ? Integer.toString(in.apiPort) : "0");
+        append(lines, "API_SECRET", traffic ? secret : "");
+        append(lines, "NETMATCH", in.netmatch ? "1" : "0");
+        append(lines, "MOBILE", in.mobile ? "1" : "0");
+        append(lines, "MATCH_ACTION", NetworkMatchRules.parseAction(in.matchAction == null || in.matchAction.isEmpty() ? "start" : in.matchAction).encode());
+        append(lines, "UNMATCH_ACTION", NetworkMatchRules.parseAction(in.unmatchAction == null || in.unmatchAction.isEmpty() ? "none" : in.unmatchAction).encode());
+        append(lines, "MODE", lineSafe(in.mode) ? clip(in.mode, 40) : "");
+        append(lines, "CONFIG", lineSafe(in.config) ? clip(in.config, 160) : "");
+        for (String v : listValues(in.ssids, false)) append(lines, "SSID", v);
+        for (String v : listValues(in.bssids, true)) append(lines, "BSSID", v);
+        for (String v : NetworkMatchRules.sanitizeSlots(in.slots)) append(lines, "SLOT", v);
+        for (String v : NetworkMatchRules.sanitizeMccMncs(in.mccMncs)) append(lines, "MCCMNC", v);
+        CRC32 crc = new CRC32();
+        crc.update(lines.toString().getBytes(StandardCharsets.UTF_8));
+        return "GEN=" + String.format(Locale.ROOT, "%08x", crc.getValue()) + "\n" + lines;
+    }
+
+    static boolean wanted(String body) {
+        return body.contains("\nTRAFFIC=1\n") || body.contains("\nNETMATCH=1\n");
+    }
+
+    static String generation(String body) {
+        if (body == null || !body.startsWith("GEN=")) return "";
+        int end = body.indexOf('\n');
+        return end < 0 ? body.substring(4) : body.substring(4, end);
+    }
+
+    /** Root command that installs the body atomically (0600 root) or removes the policy when unused. */
+    static String installCommand(String body) {
+        String path = POLICY_PATH, tmp = POLICY_PATH + ".new";
+        if (body == null || !wanted(body)) return "rm -f " + NetworkMatchRules.q(path);
+        return "mkdir -p /data/adb/hetu/policy && chmod 700 /data/adb/hetu/policy && printf %s " + NetworkMatchRules.q(body)
+                + " > " + NetworkMatchRules.q(tmp) + " && chmod 600 " + NetworkMatchRules.q(tmp)
+                + " && chown 0:0 " + NetworkMatchRules.q(tmp) + " && mv -f " + NetworkMatchRules.q(tmp) + " " + NetworkMatchRules.q(path);
+    }
+
+    private static List<String> listValues(Collection<String> values, boolean lower) {
+        TreeSet<String> out = new TreeSet<>();
+        if (values != null) for (String v : values) {
+            if (v == null) continue;
+            String t = v.trim();
+            if (t.isEmpty() || !lineSafe(t) || t.length() > 64) continue;
+            out.add(lower ? t.toLowerCase(Locale.ROOT) : t);
+            if (out.size() >= MAX_LIST) break;
+        }
+        return new ArrayList<>(out);
+    }
+
+    static boolean lineSafe(String value) {
+        if (value == null) return true;
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            if (c < 32 || c == 127) return false;
+        }
+        return true;
+    }
+
+    private static String clip(String value, int max) { return value == null ? "" : value.length() > max ? value.substring(0, max) : value; }
+    private static void append(StringBuilder out, String key, String value) { out.append(key).append('=').append(value).append('\n'); }
+
+    // ------------------------------------------------------------------ monitor-status
+    static final class Status {
+        final boolean alive, netmatch, traffic;
+        final String policy, lastAction;
+        Status(boolean alive, boolean netmatch, boolean traffic, String policy, String lastAction) {
+            this.alive = alive; this.netmatch = netmatch; this.traffic = traffic; this.policy = policy; this.lastAction = lastAction;
+        }
+        /** The daemon owns network-match actions only while it is alive with network match enabled. */
+        boolean ownsNetworkMatch() { return alive && netmatch; }
+    }
+
+    static final Status DOWN = new Status(false, false, false, "", "");
+
+    /** Last JSON line of monitor-status; anything unreadable means "not alive" (the App acts). */
+    static Status parseStatus(String output) {
+        if (output == null) return DOWN;
+        String line = "";
+        for (String l : output.split("\\r?\\n")) if (l.trim().startsWith("{")) line = l.trim();
+        if (!line.contains("\"ok\":true")) return DOWN;
+        return new Status(line.contains("\"alive\":true"), line.contains("\"netmatch\":true"), line.contains("\"traffic\":true"),
+                jsonString(line, "policy"), jsonString(line, "lastAction"));
+    }
+
+    private static String jsonString(String line, String key) {
+        Matcher m = Pattern.compile("\"" + key + "\":\"([^\"]*)\"").matcher(line);
+        return m.find() ? m.group(1) : "";
+    }
+
+    // ------------------------------------------------------------------ hand-off
+    static final class Handoff {
+        final String kind, target, label, id;
+        Handoff(String kind, String target, String label, String id) { this.kind = kind; this.target = target; this.label = label; this.id = id; }
+    }
+
+    private static final Pattern HANDOFF_ID = Pattern.compile("[0-9]{1,10}-[0-9]{1,20}-[0-9]{1,9}");
+
+    /**
+     * Validates a daemon hand-off (only Root/system can start the non-exported service). Unknown
+     * kinds, malformed ids, invalid config names and stale requests are refused.
+     */
+    static Handoff parseHandoff(String kind, String target, String label, String id, long atMs, long nowMs) {
+        if (id == null || !HANDOFF_ID.matcher(id).matches()) return null;
+        if (atMs <= 0 || nowMs - atMs > HANDOFF_MAX_AGE_MS || atMs - nowMs > HANDOFF_MAX_AGE_MS) return null;
+        String safeLabel = label == null || !lineSafe(label) ? "" : clip(label, 160);
+        if ("stop".equals(kind)) return new Handoff("stop", "", safeLabel, id);
+        if ("switch".equals(kind) && NetworkMatchRules.validConfigName(target)) return new Handoff("switch", target, safeLabel, id);
+        return null;
+    }
+
+    // ------------------------------------------------------------------ traffic batches
+    static final class Row {
+        final long minute; final String dimension, key; final long upload, download; final int connections;
+        Row(long minute, String dimension, String key, long upload, long download, int connections) {
+            this.minute = minute; this.dimension = dimension; this.key = key; this.upload = upload; this.download = download; this.connections = connections;
+        }
+    }
+
+    static final class Batch {
+        final String id;
+        final List<Row> rows = new ArrayList<>();
+        /** minute (epoch seconds, minute aligned) -> {upload, download} from the controller counters. */
+        final Map<Long, long[]> totals = new LinkedHashMap<>();
+        int rejected;
+        Batch(String id) { this.id = id; }
+    }
+
+    private static final Pattern BATCH_ID = Pattern.compile("[0-9]{1,20}-[0-9]{1,10}");
+    private static final Set<String> DIMENSION_SET = new TreeSet<>(java.util.Arrays.asList(DIMENSIONS));
+
+    /**
+     * Parses one traffic-take batch. Rows of a minute follow its "M" line; malformed lines are
+     * counted and skipped, keys are clipped to 200 characters, negative or absurd counters dropped.
+     * Returns null for an empty or foreign reply.
+     */
+    static Batch parseBatch(String text) {
+        if (text == null) return null;
+        String[] lines = text.split("\\r?\\n");
+        if (lines.length == 0) return null;
+        String[] head = lines[0].split("\t", -1);
+        if (head.length != 3 || !"HETU-TRAFFIC".equals(head[0]) || !"1".equals(head[1]) || !BATCH_ID.matcher(head[2]).matches()) return null;
+        Batch batch = new Batch(head[2]);
+        long minute = -1;
+        for (int i = 1; i < lines.length; i++) {
+            String[] f = lines[i].split("\t", -1);
+            try {
+                if (f.length == 2 && "M".equals(f[0])) {
+                    long m = Long.parseLong(f[1]);
+                    minute = m > 0 && m % 60 == 0 ? m : -1;
+                    if (minute < 0) batch.rejected++;
+                } else if (f.length == 3 && "T".equals(f[0]) && minute > 0) {
+                    long up = counter(f[1]), down = counter(f[2]);
+                    long[] t = batch.totals.get(minute);
+                    if (t == null) batch.totals.put(minute, new long[]{up, down}); else { t[0] += up; t[1] += down; }
+                } else if (f.length == 6 && "B".equals(f[0]) && minute > 0 && DIMENSION_SET.contains(f[1])) {
+                    String key = f[2].isEmpty() ? "-" : f[2].length() > 200 ? f[2].substring(0, 200) : f[2];
+                    batch.rows.add(new Row(minute, f[1], key, counter(f[3]), counter(f[4]), (int) Math.min(Integer.MAX_VALUE, counter(f[5]))));
+                } else if (!lines[i].isEmpty()) batch.rejected++;
+            } catch (NumberFormatException bad) { batch.rejected++; }
+        }
+        return batch;
+    }
+
+    private static long counter(String raw) {
+        long v = Long.parseLong(raw);
+        if (v < 0 || v > (1L << 50)) throw new NumberFormatException("counter");
+        return v;
+    }
+}
diff --git a/android-app/app/src/main/java/io/github/xgl34222220/hetu/EbpfMatcher.java b/android-app/app/src/main/java/io/github/xgl34222220/hetu/EbpfMatcher.java
new file mode 100644
index 0000000..a969d57
--- /dev/null
+++ b/android-app/app/src/main/java/io/github/xgl34222220/hetu/EbpfMatcher.java
@@ -0,0 +1,233 @@
+package io.github.xgl34222220.hetu;
+
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * eBPF 规则匹配 (opt-in, default off): the App side of hetu-root.sh's matcher.
+ *
+ * <ul>
+ *   <li>Deployment: the per-ABI loader {@code assets/hetu-bpf/<abi>/hetu-bpf} becomes
+ *   {@code /data/adb/hetu/bin/hetu-bpf} (0700 root) and {@code assets/hetu-bpf/hetu_match.o}
+ *   becomes {@code bin/hetu_match.o} (0600 root), each through a temporary file and {@code mv};
+ *   the switch itself is the policy file {@code policy/ebpf} ({@code ENABLED=1}), the same
+ *   mechanism as {@code policy/cnip}, so boot plans keep it.</li>
+ *   <li>Status: {@code ebpf}/{@code ebpfReason} from {@code hetu-root.sh status} as Chinese text.</li>
+ *   <li>Hot update: when only the app list, DIRECT apps or bypass CIDRs changed and the running
+ *   session reports {@code ebpf=active}, {@code hetu-root.sh ebpf-update} rewrites the pinned maps
+ *   with the same strings as start arguments 19/14/17; anything else falls back to a restart.</li>
+ * </ul>
+ * Pure Java (no Android API) so it is host-testable.
+ */
+final class EbpfMatcher {
+    private EbpfMatcher() {}
+
+    static final String PREF_ENABLED = "proxyEbpfMatcher";
+    /** Cached from the status probe: off | active | fallback, and the fallback reason token. */
+    static final String PREF_STATE = "proxyRootEbpfMatch";
+    static final String PREF_REASON = "proxyRootEbpfReason";
+    /** Settings signature without the hot-updatable lists, recorded by the last completed start. */
+    static final String APPLIED_BASE_KEY = "proxyRootAppliedBaseSettings";
+
+    static final String OBJECT_ASSET = "hetu-bpf/hetu_match.o";
+    static final String LOADER_NAME = "hetu-bpf";
+    static final String OBJECT_NAME = "hetu_match.o";
+    static final String POLICY_NAME = "ebpf";
+    static final String POLICY_BODY = "ENABLED=1\n";
+
+    /** The settings keys a running eBPF session can take without a restart. */
+    static final String[] LIST_KEYS = {"proxyAppPackages", "proxyBypassCidrs"};
+    /** Topology fingerprint fields the maps carry: app-scope UIDs, bypass CIDRs, DIRECT UIDs. */
+    private static final String[] LIST_FIELDS = {"uids=", "cidrs=", "direct="};
+
+    /** The loader asset for the first supported ABI that has one, or null. */
+    static String loaderAsset(String[] supportedAbis) {
+        return loaderAsset(supportedAbis, null);
+    }
+
+    /**
+     * Audit5 G13: whether a packaged asset is really there. An ABI-split (arm64-only) APK installed
+     * on an x86_64 device that translates ARM no longer carries the x86_64 payloads, so the first
+     * supported ABI is not enough. {@code null} = not checked (the old first-match behaviour).
+     */
+    interface AssetProbe { boolean exists(String path); }
+
+    /** {@link #loaderAsset(String[])} that skips ABIs whose loader is not packaged. */
+    static String loaderAsset(String[] supportedAbis, AssetProbe probe) {
+        return firstAsset(supportedAbis, "hetu-bpf/", "/" + LOADER_NAME, probe);
+    }
+
+    /** prefix + abi + suffix for the first arm64-v8a / x86_64 entry of {@code supportedAbis} the probe accepts. */
+    static String firstAsset(String[] supportedAbis, String prefix, String suffix, AssetProbe probe) {
+        if (supportedAbis == null) return null;
+        for (String abi : supportedAbis) {
+            String value = abi == null ? "" : abi.toLowerCase(Locale.ROOT);
+            if (!value.equals("arm64-v8a") && !value.equals("x86_64")) continue;
+            String path = prefix + value + suffix;
+            if (probe == null || probe.exists(path)) return path;
+        }
+        return null;
+    }
+
+    /** Writes or removes {@code policy/ebpf} exactly like {@code policy/cnip} (0600 root, temp + mv). */
+    static String policyCommand(String policyDir, boolean enabled) {
+        String policy = policyDir + "/" + POLICY_NAME, tmp = policy + ".new";
+        if (!enabled) return "; rm -f " + quote(policy);
+        return "; printf %s " + quote(POLICY_BODY) + " > " + quote(tmp)
+                + "; chmod 600 " + quote(tmp) + "; chown 0:0 " + quote(tmp)
+                + "; mv -f " + quote(tmp) + ' ' + quote(policy);
+    }
+
+    /**
+     * Installs the loader (0700) and the object (0600) under {@code binDir} when the installed
+     * bytes differ from the staged ones: copy to a temporary name, set mode/owner, verify the
+     * digest, then {@code mv}. The mode/owner of an unchanged file is re-asserted.
+     */
+    static String payloadCommand(String binDir, String loaderSource, String loaderSha256,
+                                 String objectSource, String objectSha256, String suffix) {
+        StringBuilder cmd = new StringBuilder("; mkdir -p ").append(quote(binDir));
+        install(cmd, loaderSource, loaderSha256, binDir + "/" + LOADER_NAME, suffix, "700");
+        install(cmd, objectSource, objectSha256, binDir + "/" + OBJECT_NAME, suffix, "600");
+        return cmd.toString();
+    }
+
+    /** {@link #payloadCommand} for the loader alone (0700), as the ColorOS Google check uses it. */
+    static String loaderCommand(String binDir, String loaderSource, String loaderSha256, String suffix) {
+        StringBuilder cmd = new StringBuilder("; mkdir -p ").append(quote(binDir));
+        install(cmd, loaderSource, loaderSha256, binDir + "/" + LOADER_NAME, suffix, "700");
+        return cmd.toString();
+    }
+
+    private static void install(StringBuilder cmd, String source, String sha, String target, String suffix, String mode) {
+        if (!sha.matches("[0-9a-f]{64}")) throw new IllegalArgumentException("eBPF 载荷摘要无效");
+        String tmp = target + suffix;
+        cmd.append("; if [ \"$(sha256sum ").append(quote(target)).append(" 2>/dev/null | cut -d ' ' -f 1)\" != ").append(quote(sha)).append(" ]; then")
+                .append(" cp ").append(quote(source)).append(' ').append(quote(tmp))
+                .append("; chmod ").append(mode).append(' ').append(quote(tmp)).append("; chown 0:0 ").append(quote(tmp))
+                .append("; test \"$(sha256sum ").append(quote(tmp)).append(" | cut -d ' ' -f 1)\" = ").append(quote(sha))
+                .append("; mv -f ").append(quote(tmp)).append(' ').append(quote(target))
+                .append("; fi; chmod ").append(mode).append(' ').append(quote(target)).append("; chown 0:0 ").append(quote(target));
+    }
+
+    /** {@code hetu-root.sh ebpf-update <direct> <app uids> <cidrs>}: start arguments 19, 14 and 17. */
+    static String[] updateArgs(String directUidRanges, String uidRanges, String cidrs) {
+        return new String[]{"ebpf-update", nz(directUidRanges), nz(uidRanges), nz(cidrs)};
+    }
+
+    /** Settings values without the hot-updatable lists (an absent list reads as empty). */
+    static Map<String, ?> withoutLists(Map<String, ?> values) {
+        Map<String, Object> out = new HashMap<>(values == null ? new HashMap<String, Object>() : values);
+        for (String key : LIST_KEYS) out.remove(key);
+        return out;
+    }
+
+    /**
+     * True when two topology fingerprints differ at most in the fields the maps carry. Any other
+     * field (mode, scope, IPv6, DNS, interfaces, MACs, fake-IP, the eBPF switch itself) needs a restart.
+     */
+    static boolean onlyListsChanged(String live, String next) {
+        if (live == null || next == null || live.isEmpty() || next.isEmpty()) return false;
+        String[] a = live.split("\\|", -1), b = next.split("\\|", -1);
+        if (a.length != b.length) return false;
+        for (int i = 0; i < a.length; i++) {
+            if (a[i].equals(b[i])) continue;
+            String field = listField(a[i]);
+            if (field == null || !field.equals(listField(b[i]))) return false;
+        }
+        return true;
+    }
+
+    private static String listField(String part) {
+        for (String field : LIST_FIELDS) if (part.startsWith(field)) return field;
+        return null;
+    }
+
+    /** Only an active matcher has maps to rewrite. */
+    static boolean hotUpdatable(String state) { return "active".equals(state); }
+
+    /** The switch's subtitle: what the matcher does, then what the running session reported. */
+    static String describe(boolean enabled, boolean running, String state, String reason) {
+        String about = "用 eBPF 映射匹配分应用名单与绕过网段，名单变化时无需重启；设备不支持时自动回退到原 iptables 规则。默认关闭，重启代理后生效";
+        if (!enabled) return about;
+        if (!running || state == null || state.isEmpty()) return about;
+        if ("active".equals(state)) {
+            if ("pins-missing".equals(reason)) return "已启用但映射丢失：" + reasonText(reason);
+            return "已生效：本次会话由 eBPF 匹配名单；只改应用名单或绕过网段时，「立即重启」会改为热更新，不中断连接";
+        }
+        if ("fallback".equals(state)) return "未生效，已回退到 iptables 规则：" + reasonText(reason);
+        return "本次会话未启用 eBPF 匹配，重启代理后生效";
+    }
+
+    /** Chinese text for a reason token from hetu-root.sh / the hetu-bpf loader. */
+    static String reasonText(String reason) {
+        String r = reason == null ? "" : reason.trim();
+        switch (r) {
+            case "": return "未返回原因";
+            case "selinux-denied": return "SELinux 拒绝了 bpf 调用";
+            case "bpffs-missing": return "系统没有挂载 bpf 文件系统";
+            case "bpf-syscall-unavailable": return "内核不提供 bpf 系统调用";
+            case "socket-uid-helper-unavailable": return "内核不支持按应用 UID 匹配";
+            case "lpm-unsupported": return "内核不支持网段前缀映射";
+            case "xt-bpf-unsupported": return "iptables 不支持 bpf 匹配";
+            case "xt6-bpf-unsupported": return "ip6tables 不支持 bpf 匹配";
+            case "payload-missing": return "eBPF 组件未安装";
+            case "uid-list-invalid": return "应用名单无效";
+            case "cidr-list-invalid": return "绕过网段无效";
+            case "object-invalid": return "eBPF 程序文件无效";
+            case "pins-missing": return "eBPF 映射已丢失，请重启代理";
+            case "unpin-failed": return "旧的 eBPF 映射无法清理";
+            case "usage": return "eBPF 组件版本不匹配";
+            case "error": return "eBPF 组件运行出错";
+            default: break;
+        }
+        if (r.startsWith("mode-")) return "当前运行模式不支持（仅 TPROXY / Redirect / Enhance）";
+        String[][] prefixes = {{"prog-load-", "内核拒绝加载 eBPF 程序"}, {"map-create-", "内核无法创建 eBPF 映射"},
+                {"map-update-", "eBPF 映射写入失败"}, {"map-read-", "eBPF 映射读取失败"}, {"pin-", "eBPF 映射无法固定到 bpf 文件系统"},
+                {"bpf-syscall-", "bpf 系统调用失败"}};
+        for (String[] item : prefixes) {
+            if (!r.startsWith(item[0])) continue;
+            if (r.endsWith("-permission")) return item[1] + "（权限不足）";
+            return item[1];
+        }
+        return "未知原因（" + r + "）";
+    }
+
+    /** Run modes hetu-root.sh can match with eBPF (tproxy | redirect | enhance); any other records mode-<m> and falls back. */
+    static boolean modeSupported(String modeId) {
+        return "tproxy".equals(modeId) || "redirect".equals(modeId) || "enhance".equals(modeId);
+    }
+
+    /**
+     * True while the switch differs from what the running session was started with. The applied
+     * topology fingerprint ends in {@code |ebpf=1} only when the matcher was on; the settings
+     * signature does not carry the switch, so the 重启后生效 notice asks this as well. Without a
+     * running session or a recorded fingerprint nothing is pending.
+     */
+    static boolean switchPending(boolean running, boolean enabled, String liveFingerprint) {
+        if (!running || liveFingerprint == null || liveFingerprint.isEmpty()) return false;
+        return enabled != liveFingerprint.endsWith("|ebpf=1");
+    }
+
+    /**
+     * The switch's subtitle as translatable parts (each part is one vocabulary entry; the UI
+     * translates and joins them). Unlike {@link #describe} it also covers an unsupported run mode
+     * and a matcher that was switched off but is still active until the next restart.
+     */
+    static String[] describe(boolean enabled, boolean running, String state, String reason, String modeId) {
+        if (!modeSupported(modeId)) return new String[]{"当前运行模式不支持 eBPF 规则匹配（仅 TPROXY / Redirect / Enhance）"};
+        if (!enabled && running && "active".equals(state)) return new String[]{"已关闭，重启代理后停用 eBPF 匹配；本次会话仍由 eBPF 匹配名单"};
+        if (enabled && running && "active".equals(state) && "pins-missing".equals(reason))
+            return new String[]{"已启用但映射丢失：", reasonText(reason)};
+        if (enabled && running && "fallback".equals(state)) return new String[]{"未生效，已回退到 iptables 规则：", reasonText(reason)};
+        return new String[]{describe(enabled, running, state, reason)};
+    }
+
+    private static String nz(String value) { return value == null ? "" : value; }
+
+    /** Same quoting as RootBridge.quote, kept local so this class stays free of Android types. */
+    static String quote(String value) {
+        if (value == null || value.indexOf('\0') >= 0) throw new IllegalArgumentException("Shell 参数不能为空或包含 NUL");
+        return "'" + value.replace("'", "'\\''") + "'";
+    }
+}
