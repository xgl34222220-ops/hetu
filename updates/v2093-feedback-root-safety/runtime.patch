+  if validatecfg_rc "$1"; then rm -rf "$VC_DIR" "$CHECKLOG"; ok "$(kind_label "$2") 配置校验通过"; return 0; fi
+  VA_MSG=$(tail -c 900 "$CHECKLOG" 2>/dev/null | tr -d '\033\000' | tr '\n\r\t"\\' '     ')
+  rm -rf "$VC_DIR" "$CHECKLOG"
+  fail "$(kind_label "$2") 配置校验失败：$VA_MSG"
+}
