+    /* ---------------- B4 ---------------- */
+
+    @Test fun newWordTableEntriesTranslateToAllThreeLanguages() {
+        for (key in listOf("代理已启动", "正在启动…", "确认最终运行状态…", "覆写脚本", "测速历史", "DNS 接管实测", "其他可管理核心")) {
+            listOf("en-US", "zh-TW", "ru-RU").forEach { lang ->
