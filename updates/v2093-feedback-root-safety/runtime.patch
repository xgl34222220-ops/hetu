+                }
+                val down = speed.downSamples.toList()
+                val up = speed.upSamples.toList()
+                val peak = maxOf(down.maxOrNull() ?: 0f, up.maxOrNull() ?: 0f, 1f) * 1.15f
+                val slots = (SpeedTest.PHASE_MS / SpeedTest.SAMPLE_MS).toInt().coerceAtLeast(2)
