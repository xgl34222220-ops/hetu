+  printf '%s ebpf-update ok %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$EU_COUNT" >> "$RUN/ebpf.log" 2>/dev/null || true
+  printf '{"ok":true,"updated":true,"ebpf":"active","ebpfEntries":"%s","message":"eBPF 映射已热更新，iptables 规则未改动"}\n' "$EU_COUNT"
